<!-- Modified for ASP Assistant Arknights; see NOTICE. -->
<UserControl x:Class="ASPAssistant.App.Views.BossHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ASPAssistant.App.Views">
    <UserControl.Resources>
        <views:BossHealthColumnsConverter x:Key="HealthColumns" />
        <ItemsPanelTemplate x:Key="FourColumns"><UniformGrid Columns="4" /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="HealthGrid">
            <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource HealthColumns}}" />
        </ItemsPanelTemplate>
        <Style x:Key="HealthItems" TargetType="ItemsControl">
            <Setter Property="ItemsPanel" Value="{StaticResource FourColumns}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding FitColumns, RelativeSource={RelativeSource AncestorType=views:BossHealthView}}" Value="True">
                    <Setter Property="ItemsPanel" Value="{StaticResource HealthGrid}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="HealthCell">
            <Border Margin="2" Padding="6,4" CornerRadius="{DynamicResource RowCornerRadius}" BorderThickness="1"
                    ToolTip="{Binding Name}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SectionBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Hp}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding HiddenHp, StringFormat='隐藏 {0}'}" FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HiddenHp}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Margin="0,2,0,0">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding BossHpSingle.Count}" Value="0" />
                            <Condition Binding="{Binding BossHpMulti.Count}" Value="0" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Collapsed" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <DockPanel Margin="0,0,0,6">
            <Border Width="3" Height="14" CornerRadius="{DynamicResource DotCornerRadius}"
                    Background="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Text="红字为隐藏首领" FontSize="10" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BossHasHiddenForm}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="首领血量" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
        </DockPanel>
        <Border x:Name="CurrentBossHpCard" Padding="10,8" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ItemCardBorder}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasCurrentBossHp}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding CurrentBossHp.Name, StringFormat='当前 · {0}'}" FontSize="12"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock x:Name="CurrentBossHpText" Text="{Binding CurrentBossHp.Hp}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                <TextBlock Text="{Binding CurrentBossHp.HiddenHp, StringFormat='隐藏首领 {0}'}" FontSize="12"
                           Foreground="{DynamicResource DangerBrush}" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentBossHp.HiddenHp}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
        <Expander x:Name="OtherBossHpExpander" IsExpanded="{Binding OtherBossHpExpanded, Mode=TwoWay}"
                  Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12">
            <Expander.Style>
                <Style TargetType="Expander">
                    <Setter Property="Header" Value="全部难度血量" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasCurrentBossHp}" Value="True">
                            <Setter Property="Header" Value="其他难度血量" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMultiplayerMode}" Value="True">
                            <Setter Property="Header" Value="多人难度血量" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Expander.Style>
            <Border Style="{StaticResource ItemCardBorder}" Padding="8">
                <StackPanel>
                    <TextBlock Text="多人" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,2" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ItemsControl x:Name="MultiBossHpItems" ItemsSource="{Binding BossHpMulti}" Margin="0,0,0,8"
                                  Style="{StaticResource HealthItems}" ItemTemplate="{StaticResource HealthCell}" />
                    <StackPanel x:Name="SingleBossHpSection">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMultiplayerMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="单人 · 规程等级" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,2" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ItemsControl x:Name="SingleBossHpItems" ItemsSource="{Binding OtherBossHpSingle}"
                                      Style="{StaticResource HealthItems}" ItemTemplate="{StaticResource HealthCell}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Expander>
    </StackPanel>
</UserControl>
