<!-- 对局信息 page header: this run's bans · 截屏录入 · 清除录入 · 清除 Ban -->
<UserControl x:Class="ASPAssistant.App.Views.RunBanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BanBoolToVis" /></UserControl.Resources>
        <Border Padding="10,8" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button x:Name="ManualScanButton" Content="截屏录入" Height="28" Padding="10,0"
                                Style="{StaticResource SmallActionButton}"
                                ToolTip="打开游戏内的本局信息页后点击，录入 Ban 位、盟约和敌人（Ctrl+Shift+/）"
                                Click="OnManualScanClicked" />
                        <Button x:Name="ClearHighlightsButton" Style="{StaticResource RowIconButton}" Width="24" Height="24"
                                Margin="4,0,0,0" Tag="{StaticResource IconClose}" Click="OnClearHighlightsClicked"
                                ToolTip="清除录入：清除本局盟约录入及规划限制" AutomationProperties.Name="清除录入" />
                        <Button x:Name="ClearBansButton" Style="{StaticResource RowIconButton}" Width="24" Height="24"
                                Margin="2,0,0,0" Tag="{StaticResource IconBan}" Foreground="{DynamicResource DangerBrush}"
                                Click="OnClearBansClicked" ToolTip="清除本局 Ban 位" AutomationProperties.Name="清除本局 Ban 位" />
                    </StackPanel>
                    <ToggleButton x:Name="BanDetailsToggle" DockPanel.Dock="Left" IsChecked="True" Width="16" Height="24" Margin="0,0,3,0"
                                  Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="展开 / 收起本局 Ban 详情"
                                  AutomationProperties.Name="展开或收起本局 Ban 详情">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent">
                                    <Path x:Name="Arrow" Data="M 3 2 L 7 6 L 11 2" Width="8" Height="5" Stretch="Fill"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform><RotateTransform Angle="-90" /></Path.RenderTransform>
                                    </Path>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <TextBlock Text="对局信息" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </DockPanel>
                <StackPanel x:Name="BanDetailsPanel" Visibility="{Binding IsChecked, ElementName=BanDetailsToggle, Converter={StaticResource BanBoolToVis}}">
                <TextBlock x:Name="BanBannerMeta" Text="未录入" FontSize="10" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <ItemsControl x:Name="BanCovenantPills" Margin="0,6,0,0" Focusable="False" Visibility="Collapsed" ClipToBounds="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border controls:PanelToolTip.Covenant="{Binding}" controls:PanelToolTip.Note="本局此盟约干员不完整" CornerRadius="{DynamicResource PillCornerRadius}" Padding="6,1" Margin="0,0,4,2" BorderThickness="1"
                                    Background="{DynamicResource DangerTintBrush}" BorderBrush="{DynamicResource DangerBorderBrush}">
                                <TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl x:Name="BannedOperators" Margin="0,4,0,0" Focusable="False" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:Avatar Width="24" Height="24" Small="True" Margin="0,0,4,4" Text="{Binding Name}" Source="{Binding IconPath}"
                                             ToolTip="{Binding Name}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="ManualScanStatusText" FontSize="10" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Border>
</UserControl>
