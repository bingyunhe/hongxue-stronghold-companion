<UserControl x:Class="ASPAssistant.App.Views.LineupPlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
             xmlns:vm="clr-namespace:ASPAssistant.Core.ViewModels;assembly=ASPAssistant.Core"
             x:Name="Root"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <converters:LocalPathToImageConverter x:Key="PathToImage" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:EqualityMultiConverter x:Key="StrategyIsSelected" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <!-- Small text-only link button -->
        <Style x:Key="PlannerLinkButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="cp" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cp" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented step switch -->
        <Style x:Key="PlannerSegmentButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RowCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NeutralHoverBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill buttons on result cards / footer -->
        <Style x:Key="PlannerGhostButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource RowCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NeutralPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlannerPrimaryButton" TargetType="Button" BasedOn="{StaticResource PlannerGhostButton}">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSolidBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RowCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ⅰ / Ⅱ level buttons on a covenant tile. Tag="On" marks the active level. -->
        <Style x:Key="PlannerLevelButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="{DynamicResource NumberFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SectionBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource RowCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlannerSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="PlannerHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- ── Hover details ─────────────────────────────────────────────── -->
        <!-- Operator details (same 普通 / 精锐 cards as the 干员 tab). Set Tag to the Operator on the hovered element. -->
        <ToolTip x:Key="OperatorDetailsToolTip" x:Shared="False" Placement="Left" HorizontalOffset="-8"
                 Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="False" MaxHeight="700"
                 DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Border CornerRadius="{DynamicResource RowCornerRadius}" Padding="8,4" Margin="0,0,0,6" Background="{DynamicResource EliteTintBrush}"
                            BorderBrush="{DynamicResource EliteBrush}" BorderThickness="1"
                            Visibility="{Binding PlacementTarget.DataContext.HasExtraInfo, RelativeSource={RelativeSource AncestorType=ToolTip}, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding PlacementTarget.DataContext.ExtraInfo, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource EliteBrush}" TextWrapping="Wrap" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OperatorDetailsTemplate}" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </ToolTip>

        <!-- Covenant details: requirements, ban note and every operator holding it -->
        <DataTemplate x:Key="CovenantDetailsTemplate" DataType="{x:Type vm:PlannerCovenantItem}">
            <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Width="300">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Border DockPanel.Dock="Right" CornerRadius="{DynamicResource RowCornerRadius}" Padding="7,1" VerticalAlignment="Center"
                                Background="{DynamicResource NeutralTintBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding TypeText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DockPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <Border CornerRadius="{DynamicResource RowCornerRadius}" Padding="7,1" Margin="0,0,5,0" BorderThickness="1"
                                Background="{DynamicResource AvailableTintBrush}" BorderBrush="{DynamicResource AvailableBrush}"
                                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="本局可用" FontSize="10" Foreground="{DynamicResource AvailableBrush}" />
                        </Border>
                        <Border CornerRadius="{DynamicResource RowCornerRadius}" Padding="7,1" Margin="0,0,5,0" BorderThickness="1"
                                Background="{DynamicResource DangerTintBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                Visibility="{Binding IsBanned, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="本局被 Ban" FontSize="10" Foreground="{DynamicResource DangerBrush}" />
                        </Border>
                        <Border CornerRadius="{DynamicResource RowCornerRadius}" Padding="7,1" BorderThickness="1"
                                Background="{DynamicResource EliteTintBrush}" BorderBrush="{DynamicResource EliteBrush}"
                                Visibility="{Binding CanTransformInto, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="可作为转职目标" FontSize="10" Foreground="{DynamicResource EliteBrush}" />
                        </Border>
                    </WrapPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="24" Height="20" CornerRadius="{DynamicResource RowCornerRadius}" Margin="0,0,8,4" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top">
                            <TextBlock Text="Ⅰ" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnAccentBrush}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding FirstRequirement}" FontSize="12" Margin="0,1,0,4"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Border Grid.Row="1" Width="24" Height="20" CornerRadius="{DynamicResource RowCornerRadius}" Margin="0,0,8,0" Background="{DynamicResource EliteBrush}" VerticalAlignment="Top">
                            <TextBlock Text="Ⅱ" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnAccentBrush}" />
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SecondRequirement}" FontSize="12" Margin="0,1,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                    <!-- In-game effects: base effect first, then <condition> rows -->
                    <ItemsControl ItemsSource="{Binding Effects}" Focusable="False" Margin="0,4,0,2"
                                  Visibility="{Binding HasEffects, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,7">
                                    <Border HorizontalAlignment="Left" CornerRadius="{DynamicResource RowCornerRadius}" Padding="6,1" Margin="0,0,0,3"
                                            Background="{DynamicResource EliteTintBrush}" BorderBrush="{DynamicResource EliteBrush}" BorderThickness="1"
                                            Visibility="{Binding HasCondition, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Condition}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource EliteBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding Text}" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding BanNote}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6"
                               Foreground="{DynamicResource DangerBrush}"
                               Visibility="{Binding HasBanNote, Converter={StaticResource BoolToVis}}" />
                    <Rectangle Height="1" Margin="0,4,0,8" Fill="{DynamicResource BorderBrush}" />
                    <TextBlock Text="{Binding MemberSummary}" FontSize="10" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Members}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PlannerCovenantMember}">
                                <StackPanel x:Name="member" Width="48" Margin="0,0,0,6">
                                    <controls:Avatar Width="32" Height="32" Text="{Binding Name}" Source="{Binding IconPath}" />
                                    <TextBlock x:Name="memberName" Text="{Binding Name}" FontSize="9" TextAlignment="Center" Margin="1,2,1,0"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                        <Setter TargetName="member" Property="Opacity" Value="0.35" />
                                        <Setter TargetName="memberName" Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One covenant tile -->
        <DataTemplate x:Key="CovenantTileTemplate" DataType="{x:Type vm:PlannerCovenantItem}">
            <Border x:Name="tile" Height="44" Margin="0,0,5,5" CornerRadius="{DynamicResource RowCornerRadius}" BorderThickness="1" Padding="9,0,6,0"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}"
                    ToolTipService.InitialShowDelay="350" ToolTipService.BetweenShowDelay="0" ToolTipService.ShowDuration="60000">
                <Border.ToolTip>
                    <ToolTip Placement="Left" HorizontalOffset="-8" Background="Transparent" BorderThickness="0" Padding="0"
                             HasDropShadow="False" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CovenantDetailsTemplate}" />
                    </ToolTip>
                </Border.ToolTip>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="dot" Width="6" Height="6" Margin="0,0,6,0" CornerRadius="{DynamicResource DotCornerRadius}"
                            Background="{DynamicResource AccentSolidBrush}" VerticalAlignment="Center"
                            Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}" ToolTip="本局可用" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,2,0">
                        <TextBlock x:Name="name" Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="sub" Text="{Binding TileSubText}" FontSize="10" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Border x:Name="banTag" Grid.Column="2" Visibility="Collapsed" Width="0" BorderBrush="{DynamicResource DangerBorderBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource RowCornerRadius}" Padding="4,0" VerticalAlignment="Center">
                        <TextBlock Text="禁" FontSize="10" Foreground="{DynamicResource DangerBrush}" />
                    </Border>
                    <Button x:Name="lv1" Grid.Column="3" Content="Ⅰ" Style="{StaticResource PlannerLevelButton}"
                            Command="{Binding ToggleLevel1Command}" />
                    <Button x:Name="lv2" Grid.Column="4" Content="{Binding SecondLabel}" Style="{StaticResource PlannerLevelButton}"
                            Command="{Binding ToggleLevel2Command}" IsEnabled="{Binding CanPlanSecond}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLevel1}" Value="True">
                    <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                    <Setter TargetName="lv1" Property="Background" Value="{DynamicResource AccentSolidBrush}" />
                    <Setter TargetName="lv1" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                    <Setter TargetName="lv1" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLevel2}" Value="True">
                    <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                    <Setter TargetName="lv2" Property="Background" Value="{DynamicResource AccentSolidBrush}" />
                    <Setter TargetName="lv2" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                    <Setter TargetName="lv2" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBanned}" Value="True">
                    <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                    <Setter TargetName="name" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                    <Setter TargetName="tile" Property="Opacity" Value="0.5" />
                    <Setter TargetName="name" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="name" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    <Setter TargetName="dot" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="lv1" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="lv2" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="CovenantContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
        </Style>

        <ItemsPanelTemplate x:Key="TwoColumnPanel">
            <UniformGrid Columns="2" Margin="0,0,-5,0" />
        </ItemsPanelTemplate>

        <!-- Operator on a result card: badge corner shared by both layouts -->
        <Style x:Key="PlannedBadge" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="MinWidth" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="CornerRadius" Value="{DynamicResource DotCornerRadius}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,-4,-4" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- Collapsed card: one small avatar per slot -->
        <DataTemplate x:Key="PlannedAvatarTemplate" DataType="{x:Type vm:PlannerOperatorItem}">
            <Grid Width="26" Height="26" HorizontalAlignment="Center" Margin="0,0,0,2" Background="Transparent" Tag="{Binding Operator}"
                  ToolTip="{StaticResource OperatorDetailsToolTip}" ToolTipService.IsEnabled="{Binding HasDetails}"
                  ToolTipService.InitialShowDelay="0" ToolTipService.BetweenShowDelay="0" ToolTipService.ShowDuration="60000">
                <controls:Avatar x:Name="av" Small="True" Text="{Binding Name}" Source="{Binding IconPath}" />
                <Border x:Name="badge" Style="{StaticResource PlannedBadge}">
                    <TextBlock x:Name="badgeText" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHarmony}" Value="True">
                    <Setter TargetName="badge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource SuccessBrush}" />
                    <Setter TargetName="badgeText" Property="Text" Value="+1" />
                    <Setter TargetName="badgeText" Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTransformed}" Value="True">
                    <Setter TargetName="badge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource EliteBrush}" />
                    <Setter TargetName="badgeText" Property="Text" Value="转" />
                    <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter TargetName="av" Property="Ring" Value="{DynamicResource AccentSolidBrush}" />
                    <Setter TargetName="badge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource AccentSolidBrush}" />
                    <Setter TargetName="badgeText" Property="Text" Value="锁" />
                    <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFree}" Value="True">
                    <Setter TargetName="av" Property="Source" Value="{x:Null}" />
                    <Setter TargetName="av" Property="Text" Value="+" />
                    <Setter TargetName="av" Property="Opacity" Value="0.5" />
                    <Setter TargetName="av" Property="RingDashed" Value="True" />
                    <Setter TargetName="av" Property="Ring" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Expanded card: avatar, name and the covenants the member brings -->
        <DataTemplate x:Key="PlannedOperatorTemplate" DataType="{x:Type vm:PlannerOperatorItem}">
            <DockPanel Margin="0,0,8,7" Background="Transparent" Tag="{Binding Operator}"
                       ToolTip="{StaticResource OperatorDetailsToolTip}" ToolTipService.IsEnabled="{Binding HasDetails}"
                       ToolTipService.InitialShowDelay="0" ToolTipService.BetweenShowDelay="0" ToolTipService.ShowDuration="60000">
                <Grid DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,7,0" VerticalAlignment="Center">
                    <controls:Avatar x:Name="av" Small="True" Text="{Binding Name}" Source="{Binding IconPath}" />
                    <Border x:Name="badge" Style="{StaticResource PlannedBadge}">
                        <TextBlock x:Name="badgeText" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="opName" Text="{Binding Name}" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="sub" Text="{Binding Sub}" FontSize="10" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHarmony}" Value="True">
                    <Setter TargetName="badge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource SuccessBrush}" />
                    <Setter TargetName="badgeText" Property="Text" Value="+1" />
                    <Setter TargetName="badgeText" Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTransformed}" Value="True">
                    <Setter TargetName="badge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource EliteBrush}" />
                    <Setter TargetName="badgeText" Property="Text" Value="转" />
                    <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                    <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource EliteBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter TargetName="av" Property="Ring" Value="{DynamicResource AccentSolidBrush}" />
                    <Setter TargetName="badge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource AccentSolidBrush}" />
                    <Setter TargetName="badgeText" Property="Text" Value="锁" />
                    <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFree}" Value="True">
                    <Setter TargetName="av" Property="Source" Value="{x:Null}" />
                    <Setter TargetName="av" Property="Text" Value="+" />
                    <Setter TargetName="av" Property="Opacity" Value="0.5" />
                    <Setter TargetName="av" Property="RingDashed" Value="True" />
                    <Setter TargetName="av" Property="Ring" Value="{DynamicResource TextSecondaryBrush}" />
                    <Setter TargetName="opName" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Variant matrix cell: number of plans for this people × transforms combination -->
        <DataTemplate x:Key="VariantCellTemplate" DataType="{x:Type vm:PlannerVariantCell}">
            <Button Margin="0,0,4,4" Height="40" Cursor="Hand" ToolTip="{Binding ToolTip}"
                    Command="{Binding DataContext.SelectVariantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="frame" RadiusX="{DynamicResource RowRadiusValue}" RadiusY="{DynamicResource RowRadiusValue}" StrokeThickness="1"
                                       Stroke="{DynamicResource BorderBrush}" Fill="{DynamicResource CardBackgroundBrush}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="label" Text="{Binding Text}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"
                                           FontFamily="{DynamicResource NumberFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="subLabel" Text="{Binding SubText}" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasResults}" Value="False">
                                <Setter TargetName="frame" Property="StrokeDashArray" Value="3 2" />
                                <Setter TargetName="frame" Property="Fill" Value="Transparent" />
                                <Setter TargetName="label" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter TargetName="label" Property="FontWeight" Value="Normal" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="frame" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="frame" Property="Fill" Value="{DynamicResource AccentSolidBrush}" />
                                <Setter TargetName="frame" Property="Stroke" Value="{DynamicResource AccentSolidBrush}" />
                                <Setter TargetName="label" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                <Setter TargetName="subLabel" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                <Setter TargetName="subLabel" Property="Opacity" Value="0.85" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

<DataTemplate x:Key="StrategyPieceTemplate" DataType="{x:Type vm:PlannerStrategyPiece}">
            <Border CornerRadius="{DynamicResource RowCornerRadius}" BorderThickness="1" Padding="6,5,8,5"
                    Background="{DynamicResource EliteTintBrush}" BorderBrush="{DynamicResource EliteBrush}">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,9,0">
                        <controls:Avatar Small="True" Text="{Binding Initial}" Source="{Binding IconPath}" />
                        <Border Style="{StaticResource PlannedBadge}" Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource EliteBrush}" Margin="0,0,-8,-3">
                            <TextBlock Text="{Binding Badge}" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Border CornerRadius="{DynamicResource DotCornerRadius}" Padding="4,0" Margin="5,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource CardBackgroundBrush}">
                                <TextBlock Text="占 1 人口" FontSize="9" Foreground="{DynamicResource EliteBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Sub}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource EliteBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Result card: rank, activated covenants, members; only the first is expanded by default -->
        <DataTemplate x:Key="LineupCardTemplate" DataType="{x:Type vm:PlannerLineupItem}">
            <Border x:Name="card" Style="{StaticResource ItemCardBorder}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <!-- header: click anywhere to expand / collapse -->
                    <Button Command="{Binding ToggleExpandedCommand}" Cursor="Hand" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Button.Template>
                        <DockPanel Background="Transparent">
                            <Border x:Name="rank" DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Top"
                                    CornerRadius="{DynamicResource RowCornerRadius}" Background="{DynamicResource SectionBackgroundBrush}">
                                <TextBlock x:Name="rankText" Text="{Binding Rank}" FontSize="13" FontWeight="Bold" FontFamily="{DynamicResource NumberFontFamily}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <Path x:Name="chevron" DockPanel.Dock="Right" Width="10" Height="6" Margin="8,10,4,0" VerticalAlignment="Top" Stretch="Uniform"
                                  Data="M0,0 L5,5 L10,0" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{DynamicResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding Goals}" Focusable="False" VerticalAlignment="Center" Margin="0,2,0,-4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PlannerGoalPill}">
                                        <Border x:Name="pill" CornerRadius="{DynamicResource PillCornerRadius}" Padding="7,1" Margin="0,0,4,4" BorderThickness="1"
                                                Background="{DynamicResource SuccessTintBrush}" BorderBrush="Transparent">
                                            <TextBlock x:Name="pillText" Text="{Binding Text}" FontSize="10" Foreground="{DynamicResource SuccessTextBrush}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsGoal}" Value="True">
                                                <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                                <Setter TargetName="pillText" Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsManual}" Value="True">
                                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource WarningTintBrush}" />
                                                <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource WarningMutedBrush}" />
                                                <Setter TargetName="pillText" Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Button>

                    <!-- collapsed: one row of avatars -->
                    <ItemsControl x:Name="avatars" ItemsSource="{Binding Operators}" ItemTemplate="{StaticResource PlannedAvatarTemplate}" Focusable="False" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="9" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- expanded: members, warning, actions -->
                    <StackPanel x:Name="details" Visibility="Collapsed" Margin="0,9,0,0">
                        <ContentControl Content="{Binding StrategyPiece}" ContentTemplate="{StaticResource StrategyPieceTemplate}" Focusable="False"
                                        Margin="0,0,0,9" Visibility="{Binding HasStrategyPiece, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Operators}" ItemTemplate="{StaticResource PlannedOperatorTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Border CornerRadius="{DynamicResource RowCornerRadius}" Background="{DynamicResource SectionBackgroundBrush}" Padding="8,6" Margin="0,1,0,8"
                                Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Width="12" Height="11" Margin="0,2,6,0" VerticalAlignment="Top" Stretch="Uniform"
                                      Data="M12,4 L21,20 L3,20 Z M12,10 L12,14.5 M12,17.2 L12,17.5" StrokeThickness="2" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource TransitionTextBrush}" />
                                <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TransitionTextBrush}" />
                            </DockPanel>
                        </Border>
                        <UniformGrid Columns="3">
                            <Button Content="追踪" Style="{StaticResource DialogSecondaryButton}" MinWidth="0" Margin="0,0,3,0"
                                    ToolTip="把这些干员加入追踪列表"
                                    Command="{Binding DataContext.TrackLineupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <Button Content="保存为阵容" Style="{StaticResource DialogSecondaryButton}" MinWidth="0" Margin="3,0"
                                    ToolTip="保存后可在阵容页编辑装备"
                                    Command="{Binding DataContext.SaveLineupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <Button Content="道中路线 ›" Style="{StaticResource DialogPrimaryButton}" MinWidth="0" Margin="3,0,0,0"
                                    ToolTip="从开局到大成每个阶段的过渡阵容"
                                    Command="{Binding DataContext.ShowRouteForCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                    <Setter TargetName="rank" Property="Background" Value="{DynamicResource AccentSolidBrush}" />
                    <Setter TargetName="rankText" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="avatars" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="details" Property="Visibility" Value="Visible" />
                    <Setter TargetName="chevron" Property="Data" Value="M0,5 L5,0 L10,5" />
                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- ── 道中路线 ─────────────────────────────────────────────── -->
        <!-- One operator of an open stage: avatar ringed 最终 (solid green) / 过渡 (dashed orange); 新 / 三连 badges -->
        <DataTemplate x:Key="RouteOperatorTemplate" DataType="{x:Type vm:RouteOperatorItem}">
            <StackPanel Margin="0,0,0,8" Background="Transparent" Tag="{Binding Operator}"
                        ToolTip="{StaticResource OperatorDetailsToolTip}" ToolTipService.IsEnabled="{Binding HasDetails}"
                        ToolTipService.InitialShowDelay="0" ToolTipService.BetweenShowDelay="0" ToolTipService.ShowDuration="60000">
                <Grid Width="44" Height="44" HorizontalAlignment="Center">
                    <controls:Avatar x:Name="photo" Text="{Binding Name}" Source="{Binding IconPath}"
                                     Ring="{DynamicResource TransitionBrush}" RingDashed="True" />
                    <Border Style="{StaticResource PlannedBadge}" Visibility="Visible" HorizontalAlignment="Left" Margin="-4,0,0,-4"
                            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding TierText}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource NumberFontFamily}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                    <Border x:Name="newBadge" Style="{StaticResource PlannedBadge}" Background="{DynamicResource FinalBrush}" Margin="0,0,-5,-4">
                        <TextBlock Text="新" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}" />
                    </Border>
                    <Border x:Name="tripleBadge" Style="{StaticResource PlannedBadge}" VerticalAlignment="Top" Margin="0,-5,-5,0"
                            Background="{DynamicResource EliteBrush}">
                        <TextBlock Text="三连" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}" />
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" TextAlignment="Center" Margin="2,5,2,0"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="sub" Text="{Binding Sub}" FontSize="10" TextAlignment="Center" Margin="2,0"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TransitionTextBrush}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFinal}" Value="True">
                    <Setter TargetName="photo" Property="Ring" Value="{DynamicResource FinalBrush}" />
                    <Setter TargetName="photo" Property="RingDashed" Value="False" />
                    <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViaTriple}" Value="True">
                    <Setter TargetName="tripleBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <Setter TargetName="newBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Collapsed stage: one row of small avatars -->
        <DataTemplate x:Key="RouteMiniTemplate" DataType="{x:Type vm:RouteOperatorItem}">
            <controls:Avatar x:Name="photo" Small="True" Width="24" Height="24" Margin="0,0,5,0" Opacity="0.7"
                             Text="{Binding Name}" Source="{Binding IconPath}" ToolTip="{Binding Name}"
                             Ring="{DynamicResource TransitionBrush}" RingDashed="True" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFinal}" Value="True">
                    <Setter TargetName="photo" Property="Ring" Value="{DynamicResource FinalBrush}" />
                    <Setter TargetName="photo" Property="RingDashed" Value="False" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 抓位: a card of a later stage that the current shop already offers -->
        <DataTemplate x:Key="RouteReserveTemplate" DataType="{x:Type vm:RouteOperatorItem}">
            <StackPanel Width="66" Margin="0,0,2,4" Background="Transparent" Tag="{Binding Operator}"
                        ToolTip="{StaticResource OperatorDetailsToolTip}" ToolTipService.IsEnabled="{Binding HasDetails}"
                        ToolTipService.InitialShowDelay="0" ToolTipService.BetweenShowDelay="0" ToolTipService.ShowDuration="60000">
                <Grid Width="30" Height="30" HorizontalAlignment="Center">
                    <controls:Avatar x:Name="photo" Small="True" Text="{Binding Name}" Source="{Binding IconPath}"
                                     Ring="{DynamicResource TransitionBrush}" RingDashed="True" />
                    <Border Style="{StaticResource PlannedBadge}" Visibility="Visible" HorizontalAlignment="Left" Margin="-4,0,0,-4"
                            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding TierText}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource NumberFontFamily}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Name}" FontSize="10" TextAlignment="Center" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding Sub}" FontSize="9" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFinal}" Value="True">
                    <Setter TargetName="photo" Property="Ring" Value="{DynamicResource FinalBrush}" />
                    <Setter TargetName="photo" Property="RingDashed" Value="False" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 条件 / 盾奶叠 chips -->
        <DataTemplate x:Key="RouteChipTemplate" DataType="{x:Type vm:RouteChip}">
            <Border x:Name="chip" CornerRadius="{DynamicResource PillCornerRadius}" Padding="7,1" Margin="0,0,4,4"
                    Background="{DynamicResource SectionBackgroundBrush}" ToolTip="{Binding ToolTip}">
                <TextBlock x:Name="text" Text="{Binding Text}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRole}" Value="True">
                    <Setter TargetName="chip" Property="Background" Value="{DynamicResource SuccessTintBrush}" />
                    <Setter TargetName="text" Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                    <Setter TargetName="text" Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="chip" Property="Background" Value="{DynamicResource DangerTintBrush}" />
                    <Setter TargetName="text" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="RouteStageTemplate" DataType="{x:Type vm:RouteStageItem}">
            <Border x:Name="card" Style="{StaticResource ItemCardBorder}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <Button Command="{Binding ToggleExpandedCommand}" Cursor="Hand" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button"><ContentPresenter /></ControlTemplate>
                        </Button.Template>
                        <DockPanel Background="Transparent">
                            <Path x:Name="chevron" DockPanel.Dock="Right" Width="10" Height="6" Margin="8,0,2,0" VerticalAlignment="Center" Stretch="Uniform"
                                  Data="M0,0 L5,5 L10,0" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LevelText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource NumberFontFamily}" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{Binding Subtitle}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="stageTitle" Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border x:Name="nowBadge" Visibility="Collapsed" CornerRadius="{DynamicResource PillCornerRadius}" Padding="6,0" Margin="7,0,0,0"
                                        VerticalAlignment="Center" Background="{DynamicResource AccentSolidBrush}">
                                    <TextBlock Text="当前" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" />
                                </Border>
                                <Border x:Name="pastBadge" Visibility="Collapsed" CornerRadius="{DynamicResource PillCornerRadius}" Padding="6,0" Margin="7,0,0,0"
                                        VerticalAlignment="Center" Background="{DynamicResource SectionBackgroundBrush}"
                                        ToolTip="当前终端等级已经过了这个阶段：它的过渡卡不再追踪">
                                    <TextBlock Text="已过" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <!-- collapsed -->
                    <ItemsControl x:Name="mini" ItemsSource="{Binding Operators}" ItemTemplate="{StaticResource RouteMiniTemplate}" Focusable="False" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- expanded -->
                    <StackPanel x:Name="body" Visibility="Collapsed" Margin="0,8,0,0">
                        <!-- 自动规划: what the stage is for and when to upgrade the terminal -->
                        <Border CornerRadius="{DynamicResource RowCornerRadius}" Padding="8,6" Margin="0,0,0,8"
                                Background="{DynamicResource SectionBackgroundBrush}"
                                Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding FocusText}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <DockPanel Margin="0,5,0,0" Visibility="{Binding HasUpgrade, Converter={StaticResource BoolToVis}}">
                                    <Border x:Name="paceBadge" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,1,6,0" Padding="6,0"
                                            CornerRadius="{DynamicResource PillCornerRadius}" Background="{DynamicResource AccentSoftBrush}"
                                            ToolTip="升本节奏：速升 = 不为搜牌停留；停留搜牌 = 这一档有大成 / 叠层要用的卡">
                                        <TextBlock x:Name="paceText" Text="{Binding PaceText}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding UpgradeText}" FontSize="11" LineHeight="16" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               ToolTip="回合按资金推算：升二至六本 5 / 8 / 11 / 12 / 13 费，每过一回合便宜 1；速升 = 资金够就升，稳升多留 1 回合，停留搜牌多留 2 回合" />
                                </DockPanel>
                                <TextBlock Text="{Binding UnlockText}" Style="{StaticResource PlannerHint}" Margin="0,4,0,0"
                                           Visibility="{Binding HasUnlock, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding FundsText}" Style="{StaticResource PlannerHint}" Margin="0,2,0,0"
                                           ToolTip="资金从第 1 回合的 4 起每回合 +1，到 12 为止；道具、策略给的另算"
                                           Visibility="{Binding HasFunds, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding Conditions}" ItemTemplate="{StaticResource RouteChipTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Border Width="1" Height="12" Margin="2,3,6,0" VerticalAlignment="Top" Background="{DynamicResource LineBrush}" />
                            <ItemsControl ItemsSource="{Binding Roles}" ItemTemplate="{StaticResource RouteChipTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </WrapPanel>
                        <TextBlock Text="{Binding WarningText}" FontSize="11" Margin="0,2,0,4" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TransitionTextBrush}"
                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                        <ContentControl Content="{Binding StrategyPiece}" ContentTemplate="{StaticResource StrategyPieceTemplate}" Focusable="False"
                                        Margin="0,4,0,4" Visibility="{Binding HasStrategyPiece, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Operators}" ItemTemplate="{StaticResource RouteOperatorTemplate}" Focusable="False" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <DockPanel Margin="0,0,0,6" Visibility="{Binding HasChange, Converter={StaticResource BoolToVis}}">
                            <Path DockPanel.Dock="Left" Width="10" Height="8" Margin="0,0,5,0" VerticalAlignment="Center" Stretch="Uniform"
                                  Data="M0,4 L10,4 M6,0 L10,4 L6,8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ChangeText}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"
                                       ToolTip="{Binding ChangeText}" />
                        </DockPanel>
                        <!-- 自动规划 抓位: buy ahead for later stages -->
                        <StackPanel Margin="0,0,0,4" Visibility="{Binding HasReserve, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ReserveTitle}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       ToolTip="后面阶段要用、这一档商店已经会出的卡：见到就买下留在备战区" />
                            <ItemsControl ItemsSource="{Binding Reserve}" ItemTemplate="{StaticResource RouteReserveTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Covenants}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RouteCovenantPill}">
                                    <Border x:Name="pill" CornerRadius="{DynamicResource PillCornerRadius}" Padding="7,1" Margin="0,0,4,4" BorderThickness="1"
                                            Background="{DynamicResource SuccessTintBrush}" BorderBrush="Transparent">
                                        <TextBlock x:Name="pillText" Text="{Binding Text}" FontSize="10" Foreground="{DynamicResource SuccessTextBrush}" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsGoal}" Value="True">
                                            <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                            <Setter TargetName="pillText" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter TargetName="pill" Property="Background" Value="Transparent" />
                                            <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                            <Setter TargetName="pillText" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="mini" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="body" Property="Visibility" Value="Visible" />
                    <Setter TargetName="chevron" Property="Data" Value="M0,5 L5,0 L10,5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="nowBadge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPast}" Value="True">
                    <Setter TargetName="pastBadge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="card" Property="Opacity" Value="0.7" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFinal}" Value="True">
                    <Setter TargetName="stageTitle" Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRushPace}" Value="True">
                    <Setter TargetName="paceBadge" Property="Background" Value="{DynamicResource SuccessTintBrush}" />
                    <Setter TargetName="paceText" Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStayPace}" Value="True">
                    <Setter TargetName="paceBadge" Property="Background" Value="{DynamicResource WarningTintBrush}" />
                    <Setter TargetName="paceText" Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Stepper node: 开局 → 大成 -->
        <DataTemplate x:Key="RouteStepTemplate" DataType="{x:Type vm:RouteStepItem}">
            <Button Cursor="Hand" Focusable="False" ToolTip="{Binding Name}" ToolTipService.InitialShowDelay="600"
                    Command="{Binding DataContext.SelectRouteStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button"><ContentPresenter /></ControlTemplate>
                </Button.Template>
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- connector halves: left one reaches the previous node, right one the next -->
                <Border x:Name="lineIn" Height="2" VerticalAlignment="Top" Margin="0,9,0,0" Background="{DynamicResource LineBrush}"
                        Visibility="{Binding HasLineIn, Converter={StaticResource BoolToVis}}" />
                <Border x:Name="lineOut" Grid.Column="1" Height="2" VerticalAlignment="Top" Margin="0,9,0,0" Background="{DynamicResource LineBrush}"
                        Visibility="{Binding HasLine, Converter={StaticResource BoolToVis}}" />
                <StackPanel Grid.ColumnSpan="2" HorizontalAlignment="Center">
                    <Border x:Name="dot" Width="20" Height="20" CornerRadius="{DynamicResource PillCornerRadius}" BorderThickness="1"
                            Background="{DynamicResource SectionBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}">
                        <TextBlock x:Name="mark" Text="{Binding Number}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource NumberFontFamily}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                    <TextBlock x:Name="label" Text="{Binding Name}" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPast}" Value="True">
                    <Setter TargetName="dot" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter TargetName="dot" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="mark" Property="Text" Value="✓" />
                    <Setter TargetName="mark" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="lineIn" Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="lineOut" Property="Background" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="lineIn" Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="dot" Property="Background" Value="{DynamicResource AccentSolidBrush}" />
                    <Setter TargetName="dot" Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}" />
                    <Setter TargetName="mark" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                    <Setter TargetName="label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    <Setter TargetName="label" Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── 自动规划 ─────────────────────────────────────────────── -->
        <!-- 先小后大 / 先大后小 button on a plan card; the recommended one is the primary button -->
        <DataTemplate x:Key="AutoStyleButtonTemplate" DataType="{x:Type vm:AutoStyleChoice}">
            <Button x:Name="open" Content="{Binding Label}" Style="{StaticResource DialogSecondaryButton}" MinWidth="0" Margin="0,0,6,0"
                    ToolTip="{Binding Hint}" ToolTipService.InitialShowDelay="350"
                    Command="{Binding DataContext.OpenAutoPlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                    <Setter TargetName="open" Property="Style" Value="{StaticResource DialogPrimaryButton}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One 本家: its 大成 lineup, where its stackers sit, and the two ways to play it -->
        <DataTemplate x:Key="AutoPlanCardTemplate" DataType="{x:Type vm:AutoPlanItem}">
            <Border Style="{StaticResource ItemCardBorder}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel>
                        <Border x:Name="rank" DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Top"
                                CornerRadius="{DynamicResource RowCornerRadius}" Background="{DynamicResource SectionBackgroundBrush}">
                            <TextBlock x:Name="rankText" Text="{Binding Rank}" FontSize="13" FontWeight="Bold" FontFamily="{DynamicResource NumberFontFamily}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PlannerHint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Covenants}" Focusable="False" Margin="0,8,0,-4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PlannerGoalPill}">
                                <Border x:Name="pill" CornerRadius="{DynamicResource PillCornerRadius}" Padding="7,1" Margin="0,0,4,4" BorderThickness="1"
                                        Background="{DynamicResource SuccessTintBrush}" BorderBrush="Transparent">
                                    <TextBlock x:Name="pillText" Text="{Binding Text}" FontSize="10" Foreground="{DynamicResource SuccessTextBrush}" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsGoal}" Value="True">
                                        <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                        <Setter TargetName="pillText" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ContentControl Content="{Binding StrategyPiece}" ContentTemplate="{StaticResource StrategyPieceTemplate}" Focusable="False"
                                    Margin="0,8,0,0" Visibility="{Binding HasStrategyPiece, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Operators}" ItemTemplate="{StaticResource PlannedAvatarTemplate}" Focusable="False" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="9" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{Binding StackText}" Style="{StaticResource PlannerHint}" Margin="0,7,0,0" />
                    <TextBlock Text="{Binding LayerText}" Style="{StaticResource PlannerHint}" Margin="0,2,0,0"
                               ToolTip="按普通版本特质估算，每回合给本家叠的层数（最多算 3 名叠层手）"
                               Visibility="{Binding HasLayerText, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                               Foreground="{DynamicResource TransitionTextBrush}"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Styles}" ItemTemplate="{StaticResource AutoStyleButtonTemplate}" Focusable="False" Margin="0,9,-6,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{Binding StyleReason}" Style="{StaticResource PlannerHint}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                    <Setter TargetName="rank" Property="Background" Value="{DynamicResource AccentSolidBrush}" />
                    <Setter TargetName="rankText" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Step switch + run info -->
        <StackPanel DockPanel.Dock="Top" Margin="10,10,10,8">
            <Border Background="{DynamicResource TitleBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource RowCornerRadius}" Padding="3">
                <UniformGrid Columns="3">
                    <Button x:Name="GoalTabButton" Margin="0,0,2,0"
                            Content="{Binding GoalTabText}" Command="{Binding ShowGoalPageCommand}" >
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PlannerSegmentButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowGoals}" Value="True">
                                        <Setter Property="Tag" Value="Active" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="ResultTabButton" Margin="2,0,2,0"
                            Content="{Binding ResultTabText}" Command="{Binding ShowResultPageCommand}" >
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PlannerSegmentButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowResults}" Value="True">
                                        <Setter Property="Tag" Value="Active" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- 自动规划: no targets needed, one plan per core covenant -->
                    <Button x:Name="AutoTabButton" Margin="2,0,0,0" Content="自动" Command="{Binding ShowAutoPageCommand}"
                            ToolTip="不用选目标：按本局 Ban 位为每个核心盟约生成方案，给出抓位和升本建议">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PlannerSegmentButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowAuto}" Value="True">
                                        <Setter Property="Tag" Value="Active" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </UniformGrid>
            </Border>
            <!-- 本局策略: one per run; only 暴躁铁皮 / Pith / 变形同构 change planning -->
            <Border Margin="0,8,0,0" Padding="8,7,8,7" CornerRadius="{DynamicResource CardCornerRadius}" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}"
                    Visibility="{Binding ShowRouteView, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding IsMechStrategy}"
                                    ToolTip="暴躁铁皮精锐：6 件装备、转 5 个盟约" ToolTipService.ShowOnDisabled="True">
                            <TextBlock Text="精锐" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding MechElite}" VerticalAlignment="Center" />
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                        </StackPanel>
                        <TextBlock Text="本局策略" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding StrategyChoices}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PlannerStrategyChoice}">
                                <Button Margin="0,0,4,0" Height="30" Cursor="Hand" ToolTip="{Binding Hint}"
                                        Command="{Binding DataContext.SelectStrategyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Tag>
                                        <MultiBinding Converter="{StaticResource StrategyIsSelected}">
                                            <Binding Path="Strategy" />
                                            <Binding Path="DataContext.Strategy" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </Button.Tag>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" CornerRadius="{DynamicResource RowCornerRadius}" BorderThickness="1"
                                                    Background="{DynamicResource SectionBackgroundBrush}" BorderBrush="Transparent">
                                                <TextBlock x:Name="label" Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                </Trigger>
                                                <Trigger Property="Tag" Value="on">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                    <Setter TargetName="label" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="label" Property="FontWeight" Value="Bold" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding StrategyHint}" Style="{StaticResource PlannerHint}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DockPanel Margin="0,8,0,0" Visibility="{Binding ShowGoals, Converter={StaticResource BoolToVis}}">
                <CheckBox DockPanel.Dock="Right" Content="只看本局" FontSize="11" VerticalContentAlignment="Center"
                          Foreground="{DynamicResource TextPrimaryBrush}" IsChecked="{Binding OnlyCurrentRun}"
                          IsEnabled="{Binding HasRunInfo}" ToolTip="只显示本局可用的盟约（已选目标始终显示）" />
                <Border Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" CornerRadius="{DynamicResource DotCornerRadius}"
                        Background="{DynamicResource AccentSolidBrush}" Visibility="{Binding HasRunInfo, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding RunInfoText}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </DockPanel>
        </StackPanel>

        <!-- Footer: status of the target search (the 自动 page reports its own) -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource TitleBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="10,8,10,9"
                Visibility="{Binding ShowAuto, Converter={StaticResource InverseBoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PlannerPrimaryButton}" Height="30" Padding="14,0" FontSize="12"
                        Content="{Binding ViewResultsText}" Command="{Binding ShowResultPageCommand}"
                        Visibility="{Binding ShowGoals, Converter={StaticResource BoolToVis}}" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource PlannerHint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <ProgressBar IsIndeterminate="True" Height="2" Margin="0,3,0,0" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <!-- ① Targets -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,10"
                          Visibility="{Binding ShowGoals, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding GoalChips}" Focusable="False" Margin="0,0,0,6"
                                  Visibility="{Binding HasGoals, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{DynamicResource RowCornerRadius}" Padding="9,2" Margin="0,0,5,5" BorderThickness="1"
                                        Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}">
                                    <TextBlock Text="{Binding}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="清空目标" Style="{StaticResource PlannerLinkButton}"
                                Command="{Binding ClearGoalsCommand}" Visibility="{Binding HasGoals, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="核心盟约" Style="{StaticResource PlannerSectionTitle}" />
                        <TextBlock Text="Ⅰ 3 人 · Ⅱ 6 人" Style="{StaticResource PlannerHint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding CoreCovenants}" ItemTemplate="{StaticResource CovenantTileTemplate}"
                                  ItemsPanel="{StaticResource TwoColumnPanel}" ItemContainerStyle="{StaticResource CovenantContainerStyle}"
                                  Focusable="False" />

                    <DockPanel Margin="0,10,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="人工确认盟约不参与Ⅱ级规划" Style="{StaticResource PlannerHint}" VerticalAlignment="Center" />
                        <TextBlock Text="附加盟约" Style="{StaticResource PlannerSectionTitle}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ExtraCovenants}" ItemTemplate="{StaticResource CovenantTileTemplate}"
                                  ItemsPanel="{StaticResource TwoColumnPanel}" ItemContainerStyle="{StaticResource CovenantContainerStyle}"
                                  Focusable="False" />

                    <DockPanel Margin="0,10,0,6">
                        <Button DockPanel.Dock="Right" Content="清空" Style="{StaticResource PlannerLinkButton}"
                                Command="{Binding ClearLockedCommand}" Visibility="{Binding HasLocked, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="必带干员" Style="{StaticResource PlannerSectionTitle}" />
                        <TextBlock Text="已在场上 / 一定要带的人" Style="{StaticResource PlannerHint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource RowCornerRadius}" Height="30" Padding="8,0">
                        <Grid>
                            <TextBlock Text="搜索干员，回车锁定" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=LockSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="LockSearchBox" Background="Transparent" BorderThickness="0" FontSize="11"
                                     VerticalContentAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     Text="{Binding LockSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="OnLockSearchKeyDown" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding LockSuggestions}" Margin="0,4,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PlannerGhostButton}" Margin="0,0,5,5" Padding="3,0,9,0"
                                        Tag="{Binding}" ToolTip="{StaticResource OperatorDetailsToolTip}" ToolTipService.InitialShowDelay="300"
                                        Command="{Binding DataContext.LockOperatorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Name}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Avatar Width="18" Height="18" Margin="0,0,5,0" Small="True" Text="{Binding Name}" Source="{Binding IconPath}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding LockedOperators}" Margin="0,4,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PlannerLockedOperator}">
                                <Border Height="26" CornerRadius="{DynamicResource RowCornerRadius}" Margin="0,0,5,5" Padding="3,0,2,0" BorderThickness="1"
                                        Tag="{Binding Operator}" ToolTip="{StaticResource OperatorDetailsToolTip}" ToolTipService.InitialShowDelay="300"
                                        Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Avatar Width="20" Height="20" Margin="0,0,5,0" Small="True" Text="{Binding Name}" Source="{Binding IconPath}" />
                                        <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <Button Content="✕" Style="{StaticResource PlannerLinkButton}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                Margin="5,0,4,0" Command="{Binding RemoveCommand}" ToolTip="取消锁定" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button HorizontalAlignment="Left" Content="＋ 从追踪导入" Style="{StaticResource PlannerGhostButton}"
                            Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
                            Command="{Binding ImportTrackedCommand}" ToolTip="把追踪列表里的干员设为必带" />
                </StackPanel>
            </ScrollViewer>

            <!-- ② Results, and the route of a candidate (from the results or from the 自动 page) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,10"
                          Visibility="{Binding ShowResultsPanel, Converter={StaticResource BoolToVis}}">
                <Grid>
                <!-- 道中路线 of one candidate -->
                <StackPanel Visibility="{Binding ShowRouteView, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Left" Style="{StaticResource RowIconButton}" Tag="{StaticResource IconBack}" Width="28" Height="28"
                                Margin="0,0,8,0" ToolTip="返回方案" Command="{Binding CloseRouteCommand}" />
                        <Button DockPanel.Dock="Right" Content="追踪路线" Style="{StaticResource PlannerPrimaryButton}" Height="28" Padding="11,0" Margin="6,0,0,0"
                                Command="{Binding TrackRouteCommand}"
                                ToolTip="把整条路线加入追踪：大成干员绿色标记，过渡干员橙色标记（含后期叠层用的干员）" />
                        <Button DockPanel.Dock="Right" Content="保存" Style="{StaticResource PlannerGhostButton}" Height="28" Margin="6,0,0,0"
                                Command="{Binding SaveRouteCommand}"
                                ToolTip="存进“我的阵容”：前期、中期，大成存为后期，后期叠层用的叠层手放进挂件" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding RouteTitle}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding RouteSubtitle}" Style="{StaticResource PlannerHint}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <Border CornerRadius="{DynamicResource CardCornerRadius}" BorderThickness="1" Padding="4,8,4,6" Margin="0,0,0,8"
                            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}">
                        <ItemsControl ItemsSource="{Binding RouteSteps}" ItemTemplate="{StaticResource RouteStepTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                    <!-- legend -->
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                        <Border Width="10" Height="10" BorderThickness="2" CornerRadius="{DynamicResource DotCornerRadius}" BorderBrush="{DynamicResource FinalBrush}" />
                        <TextBlock Text="最终" Style="{StaticResource PlannerHint}" Margin="4,0,10,0" VerticalAlignment="Center" />
                        <Rectangle Width="10" Height="10" StrokeThickness="2" StrokeDashArray="1.5 1" RadiusX="2" RadiusY="2" Stroke="{DynamicResource TransitionBrush}" />
                        <TextBlock Text="过渡" Style="{StaticResource PlannerHint}" Margin="4,0,10,0" VerticalAlignment="Center" />
                        <Border CornerRadius="{DynamicResource DotCornerRadius}" Padding="3,0" Background="{DynamicResource FinalBrush}">
                            <TextBlock Text="新" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" />
                        </Border>
                        <TextBlock Text="本阶段加入" Style="{StaticResource PlannerHint}" Margin="4,0,10,0" VerticalAlignment="Center" />
                        <Border CornerRadius="{DynamicResource DotCornerRadius}" Padding="3,0" Background="{DynamicResource EliteBrush}">
                            <TextBlock Text="三连" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" />
                        </Border>
                        <TextBlock Text="高于终端" Style="{StaticResource PlannerHint}" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="正在推算路线…" Style="{StaticResource PlannerHint}" Margin="0,8,0,0" TextAlignment="Center"
                               Visibility="{Binding IsRouteBusy, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl x:Name="RouteStagesList" ItemsSource="{Binding RouteStages}" ItemTemplate="{StaticResource RouteStageTemplate}" Focusable="False" />
                </StackPanel>
                <StackPanel Visibility="{Binding ShowResultList, Converter={StaticResource BoolToVis}}">
                    <WrapPanel Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding GoalChips}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="{DynamicResource PillCornerRadius}" Height="24" Padding="9,0" Margin="0,0,5,5" BorderThickness="1"
                                            Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}">
                                        <TextBlock Text="{Binding}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border CornerRadius="{DynamicResource PillCornerRadius}" Height="24" Padding="9,0" Margin="0,0,5,5" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}"
                                Visibility="{Binding HasLocked, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="9" Height="10" Margin="0,0,4,0" Stretch="Uniform" StrokeThickness="1.6" StrokeLineJoin="Round"
                                      Data="M6,11 L18,11 L18,20 L6,20 Z M8.5,11 L8.5,8 A3.5,3.5 0 0 1 15.5,8 L15.5,11" Stroke="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="必带" /> <Run Text="{Binding LockedOperators.Count, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- people × transforms matrix -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding TransformHeaders}" Focusable="False" Margin="0,0,0,3">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource PlannerHint}" TextAlignment="Center" Margin="0,0,4,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <UniformGrid Grid.Row="1" Rows="2">
                            <TextBlock Text="8 人" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,4" TextWrapping="NoWrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="9 人" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,4" TextWrapping="NoWrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </UniformGrid>
                        <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding VariantCells}"
                                      ItemTemplate="{StaticResource VariantCellTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                    <TextBlock Text="{Binding ResultHint}" Style="{StaticResource PlannerHint}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    <Border Height="6" />

                    <ItemsControl ItemsSource="{Binding VisibleLineups}" ItemTemplate="{StaticResource LineupCardTemplate}" Focusable="False" />
                    <TextBlock Text="{Binding EmptyResultText}" Style="{StaticResource PlannerHint}"
                               Margin="0,12,0,0" TextAlignment="Center"
                               Visibility="{Binding HasVisibleLineups, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ③ 自动规划: one candidate per core covenant -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,10"
                          Visibility="{Binding ShowAutoList, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PlannerHint}" Margin="0,0,0,8"
                               Text="按本局 Ban 位和策略，为每个可用的核心盟约配一套大成阵容。先选主盟约，再选打法，就能看到每个阶段的阵容、抓位和升本建议。" />
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" ToolTip="大成阵容按 9 人规划（默认 8 人）">
                            <TextBlock Text="9 人" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding AutoNinePeople}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="AutoStatusLine" Text="{Binding AutoStatusText}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </DockPanel>
                    <ProgressBar IsIndeterminate="True" Height="2" Margin="0,0,0,8" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                                 Visibility="{Binding IsAutoBusy, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl x:Name="AutoPlanList" ItemsSource="{Binding AutoPlans}" ItemTemplate="{StaticResource AutoPlanCardTemplate}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
