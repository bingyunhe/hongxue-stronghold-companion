<UserControl x:Class="ASPAssistant.App.Views.ReferenceCatalogueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
    xmlns:views="clr-namespace:ASPAssistant.App.Views"
    Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <converters:EqualityMultiConverter x:Key="ActivePortrait" />
        <ItemsPanelTemplate x:Key="PortraitGrid"><UniformGrid Columns="5" /></ItemsPanelTemplate>
        <GroupStyle x:Key="StrategyGroups" HidesIfEmpty="True">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Margin="2,7,2,4" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Name}" />
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>
        <DataTemplate x:Key="PortraitTile">
            <Button Margin="2" Padding="2" MinHeight="32" Cursor="Hand" HorizontalAlignment="Stretch"
                    Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                    AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Subtitle}"
                    MouseEnter="OnPortraitEnter" MouseLeave="OnPortraitLeave" Click="OnPortraitClick">
                <Button.Tag>
                    <MultiBinding Converter="{StaticResource ActivePortrait}">
                        <Binding /><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                    </MultiBinding>
                </Button.Tag>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" CornerRadius="{DynamicResource RowCornerRadius}" Background="#25363A"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" Padding="1">
                            <Image Source="{Binding Portrait}" Stretch="Uniform" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="on"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
        <Style x:Key="StrategyFilterChip" TargetType="ToggleButton" BasedOn="{StaticResource ClickableToggleButtonBase}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" CornerRadius="{DynamicResource RowCornerRadius}" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                            <Viewbox StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentSolidBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EnemyRowButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,2,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <EventSetter Event="MouseEnter" Handler="OnPortraitEnter" />
            <EventSetter Event="MouseLeave" Handler="OnPortraitLeave" />
            <EventSetter Event="Click" Handler="OnPortraitClick" />
            <Setter Property="Tag"><Setter.Value>
                <MultiBinding Converter="{StaticResource ActivePortrait}">
                    <Binding /><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                </MultiBinding>
            </Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Tile" Style="{StaticResource ItemCardBorder}"><ContentPresenter /></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="on"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="BossTile">
            <Button Style="{StaticResource EnemyRowButton}">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="{Binding Icon, Converter={StaticResource DetailsLocalImage}}"
                           Width="34" Height="34" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                </DockPanel>
            </Button>
        </DataTemplate>
        <Style x:Key="BountyBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SectionBackgroundBrush}" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="CornerRadius" Value="{DynamicResource RowCornerRadius}" />
        </Style>
        <DataTemplate x:Key="BountyTile">
            <Button Style="{StaticResource EnemyRowButton}">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="{Binding Icon, Converter={StaticResource DetailsLocalImage}}" Width="36" Height="36" Margin="0,0,8,0" />
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock Text="{Binding Bounty.Amount, StringFormat='＋{0}'}" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource WarningTextBrush}" />
                        <TextBlock Text="{Binding Bounty.RewardLabel}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <WrapPanel Margin="0,2,0,0">
                            <Border Style="{StaticResource BountyBadge}"><TextBlock Text="{Binding Bounty.Tag}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /></Border>
                            <Border Style="{StaticResource BountyBadge}"><TextBlock Text="{Binding Bounty.DurationLabel}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /></Border>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Margin="10,10,10,8" Height="32" Padding="9,0"
                Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource RowCornerRadius}">
            <DockPanel>
                <Viewbox DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,7,0">
                    <Canvas Width="24" Height="24"><Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextSecondaryBrush}"
                        StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas>
                </Viewbox>
                <Grid>
                    <TextBlock x:Name="SearchHint" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox x:Name="SearchBox" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderThickness="0" Padding="0" FontSize="12" VerticalContentAlignment="Center" TextChanged="OnSearchChanged" />
                </Grid>
            </DockPanel>
        </Border>
        <Grid x:Name="StrategyFilters" DockPanel.Dock="Top" Margin="10,0,10,1" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="53" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="29" /><RowDefinition Height="29" /></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="使用方式" Margin="2,0,0,4" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            <UniformGrid Grid.Row="0" Grid.Column="1" x:Name="UsageOptions" Columns="3" Rows="1" Margin="0,0,0,4">
                <ToggleButton Content="被动" Tag="被动效果" Style="{StaticResource StrategyFilterChip}" Click="OnFilterClick" />
                <ToggleButton Content="拖拽" Tag="拖拽使用" Style="{StaticResource StrategyFilterChip}" Click="OnFilterClick" />
                <ToggleButton Content="点击" Tag="点击使用" Style="{StaticResource StrategyFilterChip}" Click="OnFilterClick" />
            </UniformGrid>
            <TextBlock Grid.Row="1" Text="限制" Margin="2,0,0,4" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            <UniformGrid Grid.Row="1" Grid.Column="1" x:Name="LimitOptions" Columns="3" Rows="1" Margin="0,0,0,4">
                <ToggleButton Content="回合解锁" Tag="回合解锁" Style="{StaticResource StrategyFilterChip}" Click="OnFilterClick" />
                <ToggleButton Content="回合限制" Tag="每回合限" Style="{StaticResource StrategyFilterChip}" Click="OnFilterClick" />
                <ToggleButton Content="每场限制" Tag="每场模拟限" Style="{StaticResource StrategyFilterChip}" Click="OnFilterClick" />
            </UniformGrid>
        </Grid>
        <StackPanel x:Name="BountyFilters" DockPanel.Dock="Top" Margin="10,0,10,4" Visibility="Collapsed">
            <Grid Height="25" Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="金额" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                <UniformGrid x:Name="AmountOptions" Grid.Column="1" Columns="5" Rows="1">
                    <ToggleButton Content="1" Tag="1" Style="{StaticResource StrategyFilterChip}" Click="OnFilterClick" />
                    <ToggleButton Content="2" Tag="2" Style="{StaticResource StrategyFilterChip}" Click="OnFilterClick" />
                    <ToggleButton Content="3" Tag="3" Style="{StaticResource StrategyFilterChip}" Click="OnFilterClick" />
                    <ToggleButton Content="4" Tag="4" Style="{StaticResource StrategyFilterChip}" Click="OnFilterClick" />
                    <ToggleButton Content="5" Tag="5" Style="{StaticResource StrategyFilterChip}" Click="OnFilterClick" />
                </UniformGrid>
            </Grid>
            <Grid Height="25" Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="45" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="场次" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                <UniformGrid x:Name="RoundsOptions" Grid.Column="1" Columns="3" Rows="1">
                    <ToggleButton Content="1场" Tag="1" Style="{StaticResource StrategyFilterChip}" Click="OnFilterClick" />
                    <ToggleButton Content="2场" Tag="2" Style="{StaticResource StrategyFilterChip}" Click="OnFilterClick" />
                    <ToggleButton Content="每场" Tag="-1" Style="{StaticResource StrategyFilterChip}" Click="OnFilterClick" />
                </UniformGrid>
                <TextBlock Grid.Column="3" Text="奖励条件" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                <UniformGrid x:Name="ConditionOptions" Grid.Column="4" Columns="2" Rows="1">
                    <ToggleButton Content="击杀" Tag="击杀" Style="{StaticResource StrategyFilterChip}" Click="OnFilterClick" />
                    <ToggleButton Content="完美" Tag="完美" Style="{StaticResource StrategyFilterChip}" Click="OnFilterClick" />
                </UniformGrid>
            </Grid>
        </StackPanel>
        <Grid Margin="10,0,8,4">
            <ListBox x:Name="Entries" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template"><Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                        </Setter.Value></Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock Text="没有匹配的条目" Margin="2,12" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                <TextBlock.Style><Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=Entries}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
            <Popup x:Name="DetailsPopup" Placement="Custom" AllowsTransparency="True" StaysOpen="True" Focusable="False">
                <Border x:Name="DetailsCard" Width="235" Padding="13" CornerRadius="{DynamicResource CardCornerRadius}"
                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="PinnedLabel" DockPanel.Dock="Right" Text="已固定" Visibility="Collapsed"
                                       FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            <Image x:Name="BossPortrait" DockPanel.Dock="Left" Visibility="Collapsed" Width="32" Height="32"
                                   Margin="0,0,7,0" Source="{Binding Icon, Converter={StaticResource DetailsLocalImage}}" />
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel x:Name="StrategyMetadata" Margin="0,6,0,8">
                            <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">初始生命 <Run Text="{Binding InitialHp, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                            <TextBlock Text="{Binding Subtitle, StringFormat=发起人 · {0}}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock x:Name="BossMetadata" Visibility="Collapsed" Margin="0,6,0,8" Text="{Binding Subtitle}"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <Border Height="1" Background="{DynamicResource LineBrush}" />
                        <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="285">
                            <StackPanel>
                                <TextBlock x:Name="DetailDescription" Margin="0,8,0,0" Text="{Binding Text}" FontSize="12" LineHeight="18"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                <StackPanel x:Name="BountyDetails" Margin="0,9,0,0" Visibility="Collapsed">
                                    <TextBlock Text="{Binding Items.Count, ElementName=BountyVariants, StringFormat='同名条目（{0}）'}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <ItemsControl x:Name="BountyVariants" Margin="0,5,0,0">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Border x:Name="Variant" Margin="0,0,0,4" Padding="5,4" CornerRadius="{DynamicResource RowCornerRadius}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock x:Name="CurrentMark" DockPanel.Dock="Right" Text="当前条目" Visibility="Collapsed"
                                                                   FontSize="10" Margin="5,0,0,0" Foreground="{DynamicResource AccentBrush}" />
                                                        <TextBlock Text="{Binding Tag}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Text}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Value="on"><DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource ActivePortrait}">
                                                        <Binding /><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                    <Setter TargetName="Variant" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                                    <Setter TargetName="CurrentMark" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Height="1" Background="{DynamicResource LineBrush}" />
                                </StackPanel>
                                <StackPanel Margin="0,8,0,0">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                                        <DataTrigger Binding="{Binding Details}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers></Style></StackPanel.Style>
                                    <TextBlock Text="{Binding DetailLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ContentControl x:Name="BossHealthHost" HorizontalContentAlignment="Stretch" Focusable="False">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate><views:BossHealthView FitColumns="True" /></DataTemplate>
                                    </ContentControl.ContentTemplate>
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Margin" Value="0,8,0,0" />
                                            <Style.Triggers>
                                                <Trigger Property="Content" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </DockPanel>
</UserControl>
