<!-- Added for ASP Assistant Arknights on 2026-11-12; see NOTICE. -->
<UserControl x:Class="ASPAssistant.App.Views.DeployView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ASPAssistant.App.Views"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="TallSegItem" TargetType="ListBoxItem" BasedOn="{StaticResource SegmentedItem}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style x:Key="DeployCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,5,8" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Footer: show in game + recompute -->
        <Border x:Name="MapFooter" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,7"
                Background="{DynamicResource CardBackgroundBrush}">
            <StackPanel>
                <TextBlock x:Name="MapActionNotice" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Visibility="Collapsed" />
                <WrapPanel x:Name="MapActions" Margin="0,4">
                                <Button x:Name="ReadFieldButton" VerticalAlignment="Top" Content="识别阵容"
                                        Style="{StaticResource SmallActionButton}" Click="OnReadField" ToolTip="截取一帧识别阵容">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="选择一格复核" Click="OnChooseFieldSlot" />
                                            <MenuItem Header="识别我的棋盘并同步" Click="OnReadOwnBoard" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button x:Name="ReadFieldOptions" Content="▾" Padding="5,0" Margin="1,0,0,0"
                                        Style="{StaticResource SmallActionButton}" Click="OnReadFieldOptions" IsEnabled="{Binding IsEnabled, ElementName=ReadFieldButton}"
                                        ToolTip="更多识别选项" AutomationProperties.Name="更多识别选项" />
                                <Button x:Name="RecordHoldingButton" Content="补记持有" Margin="5,0" Style="{StaticResource SmallActionButton}" Click="OnRecordHolding" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                                    <CheckBox x:Name="AutomaticFieldToggle" Style="{StaticResource SwitchToggle}" AutomationProperties.Name="自动识别阵容"
                                              Click="OnAutomaticFieldClick" ToolTip="实时识别阵容" />
                                    <Label Target="{Binding ElementName=AutomaticFieldToggle}" Content="自动" Padding="3,0,0,0"
                                           VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                </WrapPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="RecomputeButton" Content="按最新持有重算" Tag="accent"
                        Style="{StaticResource SmallActionButton}" Click="OnRecompute" />
                <CheckBox x:Name="InGameToggle" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                          Checked="OnInGameToggled" Unchecked="OnInGameToggled" />
                <TextBlock Text="游戏内显示" FontSize="11" FontWeight="Bold" Margin="7,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="格子 · 名字 · 朝向" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Margin="10,10,5,8">
                <!-- ── Main view ─────────────────────────────────────────── -->
                <StackPanel x:Name="MainPanel">
                    <!-- Map: thumbnail, name, status in one row -->
                    <Border x:Name="MapHeaderCard" Style="{StaticResource DeployCard}" Padding="8,7">
                        <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="66" Height="34" CornerRadius="4" ClipToBounds="True" Margin="0,0,9,0"
                                    Background="{DynamicResource SectionBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Image x:Name="MapThumb" Stretch="UniformToFill" />
                            </Border>
                            <Button DockPanel.Dock="Right" Content="换地图" Height="28" Padding="7,0" Margin="6,0,0,0" ToolTip="换地图"
                                    Style="{StaticResource SmallActionButton}" Click="OnPickMap" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="MapName" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <Ellipse x:Name="MapSourceDot" Width="6" Height="6" Margin="6,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MapSourceText" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="MapSubline" FontSize="10.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </DockPanel>
                            <DockPanel Margin="0,7,0,0">
                                <Button x:Name="MapSwitchButton" Content="换阵" DockPanel.Dock="Right" Click="OnMapSwitch" Style="{StaticResource SmallActionButton}" />
                                <Button x:Name="MapGuideButton" Content="攻略讲解" DockPanel.Dock="Right" Click="OnMapGuide" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0" />
                                <StackPanel>
                                    <TextBlock x:Name="MapTeamStage" Text="当前追踪阵容" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="MapTeamName" TextWrapping="Wrap" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PivotPanel" Style="{StaticResource DeployCard}" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="返回地图" Click="OnClosePivot" Style="{StaticResource LinkButton}" />
                                <TextBlock Text="切换本局阵容" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </DockPanel>
                            <TextBlock x:Name="PivotStatus" TextWrapping="Wrap" Margin="0,5" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border BorderThickness="1" Padding="2" CornerRadius="{DynamicResource RowCornerRadius}" BorderBrush="{DynamicResource BorderBrush}">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ListBox x:Name="PivotChoices" DisplayMemberPath="Label" SelectionChanged="OnPivotSelected"
                                             Style="{StaticResource SegmentedListBox}" />
                                </ScrollViewer>
                            </Border>
                            <StackPanel x:Name="PivotDetails" Margin="0,6" />
                            <Button x:Name="PivotReplaceButton" Content="切为当前并返回地图" Style="{StaticResource DialogPrimaryButton}" Click="OnApplyPivot" />
                            <Button x:Name="PivotAppendButton" Content="同时追踪两套" Style="{StaticResource DialogSecondaryButton}" Margin="0,5,0,0" Click="OnApplyPivot" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="MapContent">
                    <views:RoundEnemyCard x:Name="RoundEnemyPanel" Margin="0,0,5,8" />

                    <!-- Toolbar: mode + field size -->
                    <DockPanel Margin="0,0,5,8">
                        <ListBox x:Name="FieldCountList" DockPanel.Dock="Right" Margin="6,0,0,0" Style="{StaticResource SegmentedListBox}" ItemContainerStyle="{StaticResource TallSegItem}"
                                 SelectionChanged="OnFieldCountChanged" ToolTip="上场人数">
                            <ListBoxItem Content="8" />
                            <ListBoxItem Content="9" />
                        </ListBox>
                        <ListBox x:Name="ModeList" Style="{StaticResource SegmentedListBox}" ItemContainerStyle="{StaticResource TallSegItem}"
                                 SelectionChanged="OnModeChanged" ToolTip="战斗：只看防线和输出；叠层：优先叠盟约层数">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBoxItem Content="实况" ToolTip="查看场上和整备区的实况" />
                            <ListBoxItem Content="战斗" />
                            <ListBoxItem Content="平衡" />
                            <ListBoxItem Content="叠层" />
                        </ListBox>
                    </DockPanel>

                    <!-- Mini board -->
                    <Border x:Name="BoardCard" Style="{StaticResource DeployCard}" Padding="6,8,6,7">
                        <StackPanel>
                            <DockPanel Margin="2,0,2,4">
                                <TextBlock x:Name="BoardStatusText" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock x:Name="BoardTitleText" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </DockPanel>
                            <DockPanel Margin="2,0,2,5">

                                <TextBlock x:Name="RoutePhaseNumber" DockPanel.Dock="Right" Margin="5,0,0,0"
                                           Visibility="Collapsed" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock x:Name="RoundRouteStatus" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </DockPanel>
                            <TextBlock x:Name="LiveMessage" Visibility="Collapsed" FontSize="10" TextWrapping="Wrap" Margin="2,1"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel x:Name="RouteDetails" Margin="2,0,2,0" />
                            <Viewbox x:Name="StageRoutesBox" Stretch="Uniform" MaxWidth="380" MaxHeight="200"
                                     HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,6">
                                <Canvas x:Name="StageRoutesCanvas" Background="{DynamicResource PanelBackgroundBrush}" />
                            </Viewbox>
                            <Viewbox Stretch="Uniform" MaxWidth="380" HorizontalAlignment="Center"
                                     ToolTip="拖动干员换位置，点一下看详情">
                                <Canvas x:Name="BoardCanvas" Background="Transparent"
                                        MouseMove="OnBoardMouseMove" MouseLeftButtonUp="OnBoardMouseUp"
                                        PreviewMouseRightButtonUp="OnBoardFeedbackMenu" />
                            </Viewbox>
                    <!-- Bench + pool entry -->
                    <Border x:Name="BenchCard" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="2,4,2,0" Margin="0,3,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="PoolSummary" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="PoolMeta" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </DockPanel>
                            <TextBlock x:Name="LastFieldRead" FontSize="10" Margin="0,2,0,0" Visibility="Collapsed"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <UniformGrid x:Name="BenchRow" Columns="2" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                            <Border x:Name="ChecksBorder" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="2,6,2,0" Padding="0,6,0,0">
                                <WrapPanel x:Name="ChecksRow" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="StatusText" FontSize="11" Margin="2,0,5,8" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />

                    <Border x:Name="CorrectionPanel" Visibility="Collapsed" Style="{StaticResource DeployCard}">
                        <StackPanel>
                            <TextBlock x:Name="CorrectionTitle" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="CorrectionHint" Margin="0,3" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <WrapPanel x:Name="CorrectionChoices" />
                            <Button x:Name="PickCorrectionButton" Content="选其他干员" HorizontalAlignment="Left" Margin="0,4" Click="OnPickCorrection" Style="{StaticResource SmallActionButton}" />
                            <Button x:Name="ConfirmCorrectionButton" Click="OnConfirmCorrection" Style="{StaticResource DialogPrimaryButton}" />
                            <Button x:Name="CountOnlyButton" Margin="0,4,0,0" Click="OnCountOnly" Style="{StaticResource DialogSecondaryButton}" />
                            <Button x:Name="LeaveCorrectionButton" Click="OnLeaveCorrection" Margin="0,5,0,0" HorizontalAlignment="Center" Style="{StaticResource LinkButton}" />
                        </StackPanel>
                    </Border>
                    <!-- Plan: checks + operators -->
                    <StackPanel x:Name="PlanPanel">
                        <UniformGrid x:Name="OperatorGrid" Columns="2" Margin="0,0,1,4" />
                    </StackPanel>

                    <!-- Detail of the selected operator -->
                    <Border x:Name="DetailCard" Style="{StaticResource DeployCard}" Visibility="Collapsed">
                        <StackPanel x:Name="DetailBody" />
                    </Border>
                    </StackPanel>


                </StackPanel>

                <!-- ── Pool view ─────────────────────────────────────────── -->
                <StackPanel x:Name="PoolPanel" Visibility="Collapsed">
                    <DockPanel Margin="0,0,5,6">
                        <Border Height="32" CornerRadius="{DynamicResource RowCornerRadius}" BorderThickness="1"
                                Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                        <Grid>
                            <TextBox x:Name="PoolSearch" Padding="24,0,8,0" VerticalContentAlignment="Center" FontSize="12"
                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}" TextChanged="OnPoolSearchChanged" />
                            <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                                  Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False" />
                            <TextBlock x:Name="PoolSearchHint" Text="搜名字或盟约" FontSize="12" Margin="27,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" />
                        </Grid>
                        </Border>
                    </DockPanel>
                    <DockPanel Margin="0,0,5,6">
                        <ToggleButton x:Name="PoolAllStagesToggle" DockPanel.Dock="Right" Content="全程全部" FontSize="10.5" Margin="4,0,0,4"
                                      Style="{StaticResource VariantToggleButton}" Background="{DynamicResource NeutralTintBrush}" VerticalAlignment="Top"
                                      Checked="OnPoolAllStagesChanged" Unchecked="OnPoolAllStagesChanged" ToolTip="查看全部阶段的干员；不改变当前阶段和本局获取状态" />
                        <WrapPanel>
                        <ListBox x:Name="PoolFilterList" Style="{StaticResource SegmentedListBox}" SelectionChanged="OnPoolFilterChanged" SelectedIndex="0" Margin="0,0,6,4">
                            <ListBoxItem Content="全部" /><ListBoxItem Content="已获取" />
                        </ListBox>
                        <Button Content="本阶段已获取" Margin="0,0,5,4" Style="{StaticResource SmallActionButton}" Click="OnOwnCurrentStage" ToolTip="仅标记当前阶段干员已获取，不会自动标记精锐" />
                        <Button Content="＋ 添加" Margin="0,0,0,4" Tag="accent" Style="{StaticResource SmallActionButton}" Click="OnAddOther" />
                        </WrapPanel>
                    </DockPanel>
                    <ItemsControl x:Name="PoolCovenantFilters" Style="{StaticResource MissingCovenantChips}" Margin="0,0,5,3" />
                    <TextBlock x:Name="PoolHeaderMeta" FontSize="10.5" TextWrapping="Wrap" Margin="2,0,5,7" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Grid x:Name="PoolStageRow" Margin="2,0,7,7" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="PoolTrackedToggle" AutomationProperties.Name="展开或收起干员列表" Width="22" Height="26" Margin="0,0,4,0" Style="{StaticResource SmallActionButton}"
                                Background="Transparent" BorderThickness="0" Padding="3" Click="OnTogglePoolTracked" ToolTip="收起干员列表">
                            <Path x:Name="PoolFoldIcon" Data="M3,6 L8,11 L13,6" Width="11" Height="7" Stretch="Fill" Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Button>
                        <Grid Grid.Column="1">
                            <TextBlock x:Name="PoolStageTitle" Text="成型阵容干员" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <ComboBox x:Name="PoolStageSelector" Height="30" MinWidth="0" DisplayMemberPath="Label" Visibility="Collapsed"
                                      SelectionChanged="OnPoolStageChanged" ToolTip="选择当前追踪阶段，与购买清单同步" />
                        </Grid>
                        <TextBlock x:Name="PoolTrackedCount" Grid.Column="2" FontSize="10" FontWeight="Bold" Margin="5,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}" ToolTip="当前查看范围的已获取人数 / 总人数" />
                        <StackPanel x:Name="PoolAutomaticPanel" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="自动" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <CheckBox x:Name="PoolAutomaticToggle" Style="{StaticResource SwitchToggle}" Checked="OnPoolAutomaticChanged" Unchecked="OnPoolAutomaticChanged"
                                      ToolTip="按已识别回合自动切换；手动选择阶段会关闭自动" />
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="PoolTrackedBody" Margin="0,0,5,0" />
                    <StackPanel x:Name="PoolGroups" Margin="0,0,5,0" />
                </StackPanel>

                <!-- ── No map ────────────────────────────────────────────── -->
                <StackPanel x:Name="NoMapPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource DeployCard}">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="NoMapBack" DockPanel.Dock="Right" Content="‹ 返回" Style="{StaticResource LinkButton}"
                                        Click="OnBackToMain" />
                                <TextBlock x:Name="NoMapTitle" Text="还没认出当前地图" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </DockPanel>
                            <TextBlock x:Name="NoMapHint" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="进入休整期、能看到完整棋盘时会自动识别。也可以先手动选：" />
                            <UniformGrid x:Name="MapChoices" Columns="2" Margin="0,9,0,0" />
                            <Button x:Name="FollowRecognitionButton" Content="改回自动识别" Margin="0,4,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource SmallActionButton}" Click="OnFollowRecognition" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
