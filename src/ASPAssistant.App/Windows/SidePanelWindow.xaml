                                        <DockPanel>
                                            <Button x:Name="ClearRecognitionHotkeyButton" Content="清除" Height="28" MinHeight="0" ToolTip="清除快速识别快捷键" DockPanel.Dock="Right" Click="OnClearRecognitionHotkey" Style="{StaticResource DialogSecondaryButton}" Padding="8,2" Margin="6,0,0,0" />
                                            <TextBox x:Name="RecognitionHotkeyBox" Style="{StaticResource DialogTextBox}" Height="28" MinHeight="28" Padding="8,3" Text="未设置（点击录入）" IsReadOnly="True" PreviewKeyDown="OnHotkeyKeyDown" AutomationProperties.Name="快速识别快捷键" VerticalContentAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock x:Name="RecognitionHotkeyStatus" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                </StackPanel>
                                <StackPanel x:Name="AboutSettingsPage" Visibility="Collapsed">
                                <TextBlock Text="更新" Style="{StaticResource SettingsCaption}" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <DockPanel>
                                        <Button x:Name="CheckUpdateButton" DockPanel.Dock="Right" Content="检查更新" Tag="accent"
                                                Click="OnCheckUpdate" Style="{StaticResource SmallActionButton}" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="CurrentVersionText" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock x:Name="UpdateStatusText" Text="启动后检测更新，下载由你决定"
                                                       FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCard}" Margin="0,6,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" FontSize="11">
                                                <Hyperlink NavigateUri="https://mirrorchyan.com/?source=hongxue_stronghold_companion_settings"
                                                           RequestNavigate="OnOpenMirrorChyan" Foreground="{DynamicResource AccentBrush}">官网</Hyperlink>
                                            </TextBlock>
                                            <TextBlock Text="MirrorChyan CDK" FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,6,0,4">
                                            <Button x:Name="SaveMirrorChyanCdkButton" DockPanel.Dock="Right" Content="保存" Click="OnSaveMirrorChyanCdk"
                                                    Style="{StaticResource SmallActionButton}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <PasswordBox x:Name="MirrorChyanCdkBox" AutomationProperties.Name="MirrorChyan CDK"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource InputBackgroundBrush}"
                                                         BorderBrush="{DynamicResource BorderBrush}" Padding="6,4" MinHeight="28" />
                                        </DockPanel>
                                        <TextBlock x:Name="MirrorChyanCdkStatus" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Button x:Name="UpdateHistoryButton" Content="更新日志" Click="OnOpenUpdateHistory" Style="{StaticResource SmallActionButton}" HorizontalAlignment="Left" Margin="0,8,0,10" />
                                <TextBlock Text="数据" Style="{StaticResource SettingsCaption}" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel x:Name="ConfigurationControls">
                                        <TextBlock Text="配置保存路径" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBox x:Name="ConfigurationDirectoryText" IsReadOnly="True" Style="{StaticResource DialogTextBox}" TextWrapping="Wrap"
                                                 FontSize="11" Margin="0,6,0,10" AutomationProperties.Name="配置保存路径" />
                                        <WrapPanel>
                                            <Button x:Name="ExportFullConfigurationButton" Content="导出完整配置" Click="OnExportConfiguration" Tag="Full" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6" />
                                            <Button x:Name="ExportSoftwareConfigurationButton" Content="导出软件配置" Click="OnExportConfiguration" Tag="Software" Style="{StaticResource SmallActionButton}" Margin="0,0,0,6" />
                                            <Button x:Name="ExportLineupConfigurationButton" Content="导出阵容配置" Click="OnExportConfiguration" Tag="Lineups" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6" />
                                            <Button x:Name="ImportConfigurationButton" Content="导入配置" Click="OnImportConfiguration" Style="{StaticResource SmallActionButton}" Margin="0,0,0,6" />
                                        </WrapPanel>
                                        <TextBlock x:Name="ConfigurationStatusText" Text="完整配置含软件设置、阵容和追踪；阵容配置仅含阵容及排序。导入后需完全退出助手，再手动启动。"
                                                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="反馈" Style="{StaticResource SettingsCaption}" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="FeedbackTitle" Text="遇到报错或识别问题？" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="填写问题、预览诊断内容并导出反馈包。截图由你选择附上。" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10" />
                                        <Button x:Name="FeedbackButton" Content="反馈与诊断" Click="OnOpenFeedback" Style="{StaticResource SmallActionButton}" HorizontalAlignment="Left" Margin="0,0,0,4" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="ProjectAddressText" HorizontalAlignment="Center" Margin="0,10,0,8" FontSize="12">
                                    <Hyperlink x:Name="ProjectAddressLink" NavigateUri="https://github.com/bingyunhe/hongxue-stronghold-companion"
                                               Foreground="{DynamicResource AccentBrush}" RequestNavigate="OnProjectAddressNavigate">项目地址，欢迎star</Hyperlink>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Center" Margin="0,0,0,8" FontSize="12">
                                    <Hyperlink x:Name="QqGroupLink" NavigateUri="mqqapi://card/show_pslcard?src_type=internal&amp;version=1&amp;uin=1104531618&amp;card_type=group&amp;source=qrcode"
                                               Foreground="{DynamicResource AccentBrush}" RequestNavigate="OnProjectAddressNavigate">QQ 交流群：1104531618</Hyperlink>
                                </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Transient toast: shown via SidePanelWindow.ShowToast(). Click-through unless visible. -->
                <Border x:Name="ToastBorder"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,30"
                        MaxWidth="280"
                        Background="{DynamicResource ToastBackgroundBrush}"
                        BorderBrush="{DynamicResource AccentStrongBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RowCornerRadius}"
                        Padding="12,8"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Opacity="0">
                    <TextBlock x:Name="ToastText"
                               Foreground="{DynamicResource TitleTextBrush}"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Custom resize grip: three accent-coloured diagonal lines -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Width="20" Height="20" Cursor="SizeNWSE"
                        Background="Transparent" ToolTip="拖动调整窗口大小">
                    <Canvas Width="20" Height="20">
                        <Line X1="6"  Y1="18" X2="18" Y2="6"
                              Stroke="{DynamicResource AccentBorderBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line X1="11" Y1="18" X2="18" Y2="11"
                              Stroke="{DynamicResource AccentStrongBorderBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line X1="16" Y1="18" X2="18" Y2="16"
                              Stroke="{DynamicResource AccentSolidBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Border>

                <Grid x:Name="BanProcessingMask"
                      Visibility="Collapsed"
                      Background="#CC000000"
                      IsHitTestVisible="True">
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource MaskCardBackgroundBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RowCornerRadius}"
                            Padding="16,12">
                        <TextBlock x:Name="BanProcessingMaskText"
                                   Text="ban位识别中，请勿操作鼠标"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
