<!-- Modified for ASP Assistant Arknights on 2026-11-13; see NOTICE. -->
<Window x:Class="ASPAssistant.App.Windows.SidePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ASPAssistant.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="鸿雪·卫戍助手"
        Width="310" MinWidth="280" MaxWidth="400"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Topmost="False"
        Cursor="Arrow"
        Icon="{StaticResource AspaLogo}"
        Background="{DynamicResource PanelBackgroundBrush}">
    <Window.Resources><BooleanToVisibilityConverter x:Key="GameStartBoolToVis" /></Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Border x:Name="SidebarRoot" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.LayoutTransform><ScaleTransform x:Name="SidebarScaleTransform" /></Border.LayoutTransform>
        <DockPanel>
            <!-- Custom title bar: logo, terminal level / round status, settings · minimize · close -->
            <Border DockPanel.Dock="Top" Height="36" Background="{DynamicResource TitleBackgroundBrush}"
                    BorderBrush="{DynamicResource TitleDecorBrush}" BorderThickness="{DynamicResource TitleDecorThickness}"
                    MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                        <ToggleButton x:Name="PinTopmostButton" Tag="{StaticResource IconPin}"
                                      IsChecked="{Binding IsChecked, ElementName=ForceTopmostToggle, Mode=TwoWay}"
                                      IsEnabled="{Binding IsEnabled, ElementName=ForceTopmostToggle}"
                                      AutomationProperties.Name="强制置顶">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource ClickableToggleButtonBase}">
                                    <Setter Property="Width" Value="28" />
                                    <Setter Property="Height" Value="28" />
                                    <Setter Property="Margin" Value="0,0,2,0" />
                                    <Setter Property="Foreground" Value="{DynamicResource TitleMutedBrush}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="ToolTip" Value="强制置顶：已关闭（点击开启）" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RowCornerRadius}">
                                                    <ContentPresenter Content="{TemplateBinding Tag}" ContentTemplate="{StaticResource LineIcon}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource TitleChipBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource TitleChipBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}" />
                                            <Setter Property="ToolTip" Value="强制置顶：已开启（点击关闭）" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <Button x:Name="SettingsButton" Click="OnToggleSettings" Tag="{StaticResource IconSettings}"
                                AutomationProperties.Name="设置" ToolTip="设置">
                            <Button.Style>
                                <!-- Highlighted while the settings panel is open -->
                                <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=SettingsPanel}" Value="Visible">
                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="OnMinimize" Tag="{StaticResource IconMinimize}" AutomationProperties.Name="最小化" ToolTip="最小化"
                                Style="{StaticResource TitleBarButton}" />
                        <Button x:Name="CloseAssistantButton" Click="OnClose" Tag="{StaticResource IconClose}" AutomationProperties.Name="关闭" ToolTip="关闭助手（每次询问）"
                                Style="{StaticResource CloseButton}" />
                    </StackPanel>
                    <DockPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" LastChildFill="True">
                        <Image x:Name="BrandLogoImage" Source="{StaticResource AspaLogo}" Width="20" Height="20"
                               Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="鸿雪·卫戍助手图标" />
                        <Border x:Name="StatusChip" DockPanel.Dock="Right" Height="22" CornerRadius="11" Padding="6,0" VerticalAlignment="Center"
                                Background="{DynamicResource TitleChipBrush}" BorderBrush="{DynamicResource TitleChipBorderBrush}"
                                BorderThickness="1" ToolTip="终端等级：从商店左侧的升级卡自动识别，可在追踪页手动指定">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="终端" FontSize="11" Foreground="{DynamicResource TitleMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusTerminalText" Text="–" Margin="5,0,0,0" FontSize="14" FontWeight="Bold"
                                           FontFamily="{DynamicResource NumberFontFamily}" Foreground="{DynamicResource TitleTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="BrandTitleText" Text="鸿雪·卫戍助手" Foreground="{DynamicResource TitleTextBrush}"
                                   FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="7,0,6,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="鸿雪·卫戍助手" />
                    </DockPanel>
                </DockPanel>
            </Border>

            <DockPanel x:Name="PanelContent">
            <!-- Update notification banner (hidden until a new version is found) -->
            <Border x:Name="UpdateBanner" DockPanel.Dock="Top"
                    Background="{DynamicResource SuccessTintBrush}"
                    BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="0,0,0,1"
                    Visibility="Collapsed" Padding="10,5,10,4">
                <StackPanel>
                    <!-- Top row: text + buttons -->
                    <DockPanel>
                        <!-- Action button: "查看更新" or "立即重启" -->
                        <Button x:Name="UpdateActionButton" DockPanel.Dock="Right"
                                Click="OnBannerAction"
                                Padding="8,3" FontSize="11" Cursor="Hand"
                                BorderThickness="0" Background="{DynamicResource SuccessBrush}" Foreground="White">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                                            CornerRadius="{DynamicResource RowCornerRadius}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SuccessHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="UpdateActionIcon" Text="↑ " FontWeight="Bold" />
                                <TextBlock x:Name="UpdateActionText" Text="查看更新" />
                            </StackPanel>
                        </Button>
                        <!-- Skip this version button -->
                        <Button x:Name="SkipVersionButton" DockPanel.Dock="Right"
                                Click="OnSkipVersion"
                                Padding="6,3" FontSize="11" Cursor="Hand" Margin="0,0,6,0"
                                BorderThickness="0" Background="Transparent" Foreground="{DynamicResource SuccessTextBrush}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                                            CornerRadius="{DynamicResource RowCornerRadius}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource NeutralHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="跳过该版本" />
                        </Button>
                        <TextBlock x:Name="UpdateBannerText"
                                   Foreground="{DynamicResource SuccessTextBrush}" FontSize="11"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <!-- Download progress bar (visible during background download) -->
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock x:Name="UpdateBannerPercent" DockPanel.Dock="Right"
                                   Text="" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SuccessTextBrush}" Visibility="Collapsed" />
                        <ProgressBar x:Name="UpdateBannerProgress"
                                     Height="2"
                                     Minimum="0" Maximum="100" Value="0"
                                     Visibility="Collapsed"
                                     VerticalAlignment="Center"
                                     Background="{DynamicResource NeutralStrongBrush}" Foreground="{DynamicResource SuccessBrush}"
                                     BorderThickness="0" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Fullscreen warning banner -->
            <Border x:Name="FullscreenBanner" DockPanel.Dock="Top"
                    Background="{DynamicResource WarningTintBrush}"
                    BorderBrush="{DynamicResource WarningBrush}" BorderThickness="0,0,0,1"
                    Visibility="Collapsed" Padding="10,6">
                <DockPanel>
                    <Button x:Name="FullscreenBannerClose" DockPanel.Dock="Right"
                            Click="OnDismissFullscreenBanner"
                            Width="20" Cursor="Hand"
                            BorderThickness="0" Background="Transparent" Foreground="{DynamicResource WarningBrush}"
                            FontSize="12" FontWeight="Bold" Content="✕"
                            VerticalAlignment="Top" Margin="4,0,0,0"
                            ToolTip="关闭提示" />
                    <StackPanel>
                        <TextBlock Text="推荐在窗口模式下运行"
                                   Foreground="{DynamicResource WarningTextBrush}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="（全屏下如有遮挡可拖动右下角调节窗口）"
                                   Foreground="{DynamicResource WarningMutedBrush}" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Tab content + visible resize grip overlay -->
            <Grid>
                <TabControl x:Name="MainTabs" Style="{StaticResource DarkTabControl}" SelectionChanged="OnMainTabChanged">
                    <!-- 图鉴 -->
                    <TabItem x:Name="CodexTab" Header="图鉴" Tag="{StaticResource IconCodex}" HorizontalContentAlignment="Stretch">
                        <DockPanel Background="{DynamicResource PanelBackgroundBrush}">
                            <Border DockPanel.Dock="Top" Padding="10,10,10,0">
                                <ListBox x:Name="CodexSegment" Style="{StaticResource SegmentedListBox}" HorizontalAlignment="Stretch"
                                         SelectedIndex="0" SelectionChanged="OnCodexSegmentChanged" SizeChanged="OnCodexWidthChanged">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SegmentedItem}">
                                            <Setter Property="MinHeight" Value="26" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="Padding" Value="2,3" />
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Orientation" Value="Horizontal" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                                            <Setter Property="Orientation" Value="Vertical" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{Binding}" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0" FontSize="10"
                                                                       FontFamily="{DynamicResource NumberFontFamily}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBoxItem Content="干员" />
                                    <ListBoxItem Content="装备" />
                                    <ListBoxItem Content="策略" />
                                    <ListBoxItem Content="首领" />
                                    <ListBoxItem Content="悬赏" />
                                </ListBox>
                            </Border>
                            <Grid>
                                <views:OperatorBrowseView x:Name="OperatorView" />
                                <views:EquipmentBrowseView x:Name="EquipmentView" Visibility="Collapsed" />
                                <ContentControl x:Name="ReferenceHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
                            </Grid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="追踪" Tag="{StaticResource IconTracking}">
                        <views:TrackingView x:Name="TrackingView" />
                    </TabItem>
                    <!-- 阵容: saved lineups (search / 筛选 / 本局推荐) and the planner behind one segment -->
                    <TabItem x:Name="LineupsTab" Header="阵容" Tag="{StaticResource IconLineups}">
                        <DockPanel Background="{DynamicResource PanelBackgroundBrush}">
                            <Border DockPanel.Dock="Top" Padding="10,10,10,0">
                                <ListBox x:Name="LineupsSegment" Style="{StaticResource SegmentedListBox}" HorizontalAlignment="Stretch"
                                         SelectedIndex="0" SelectionChanged="OnLineupsSegmentChanged">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <!-- same size as 追踪's 购买清单 / 站位 -->
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SegmentedItem}">
                                            <Setter Property="MinHeight" Value="26" />
                                            <Setter Property="FontSize" Value="12" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBoxItem Content="我的阵容" />
                                    <ListBoxItem Content="规划" />
                                </ListBox>
                            </Border>
                            <Grid>
                                <views:LineupListView x:Name="LineupView" />
                                <views:LineupPlannerView x:Name="PlannerView" Visibility="Collapsed" />
                            </Grid>
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="RunInfoTab" Header="对局信息" Tag="{StaticResource IconEnemy}">
                        <DockPanel>
                            <views:RunBanView x:Name="RunBanView" DockPanel.Dock="Top" Margin="10,10,10,0" />
                            <views:EnemyView x:Name="EnemyView" />
                        </DockPanel>
                    </TabItem>
                </TabControl>

                <!-- Settings page: covers the tabs; the gear (or 返回) closes it -->
                <Border x:Name="SettingsPanel" Visibility="Collapsed" Background="{DynamicResource PanelBackgroundBrush}">
                    <DockPanel>
                        <Border x:Name="SettingsTitleBar" DockPanel.Dock="Top" Height="36" Background="{DynamicResource TabBarBackgroundBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Click="OnToggleSettings" Tag="{StaticResource IconBack}" ToolTip="返回" AutomationProperties.Name="返回"
                                        Style="{StaticResource TitleBarButton}" Foreground="{DynamicResource TabTextBrush}" />
                                <TextBlock Text="设置" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TabActiveBrush}" />
                            </StackPanel>
                        </Border>
                        <TabControl x:Name="SettingsCategoryList" DockPanel.Dock="Top" Height="30"
                                    Style="{StaticResource DarkTabControl}" SelectionChanged="OnSettingsCategoryChanged" SelectedIndex="0"
                                    AutomationProperties.Name="设置分类">
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                    <Setter Property="Height" Value="29" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                                <Condition Binding="{Binding IsChecked, ElementName=FollowModeThemeToggle}" Value="False" />
                                                <Condition Binding="{Binding SelectedIndex, ElementName=UiThemeSelector}" Value="0" />
                                                <Condition Binding="{Binding SelectedIndex, ElementName=DayNightSelector}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                                <Condition Binding="{Binding IsChecked, ElementName=FollowModeThemeToggle}" Value="True" />
                                                <Condition Binding="{Binding SelectedIndex, ElementName=GameThemeSelector}" Value="0" />
                                                <Condition Binding="{Binding SelectedIndex, ElementName=DayNightSelector}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TabControl.ItemContainerStyle>
                            <TabItem Header="游戏" />
                            <TabItem Header="界面" />
                            <TabItem Header="按键" />
                            <TabItem Header="关于" />
                        </TabControl>
                        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="10,0,10,14">
                                <StackPanel x:Name="GameSettingsPage">
                                <StackPanel x:Name="GameThemePanel">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="手动" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=AutomaticThemeToggle}" Value="True">
                                                            <Setter Property="Text" Value="自动" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <CheckBox x:Name="AutomaticThemeToggle" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="模式主题自动识别" />
                                    </StackPanel>
                                    <TextBlock Text="模式主题" Style="{StaticResource SettingsCaption}" />
                                </DockPanel>
                                <ListBox x:Name="GameThemeSelector" IsEnabled="{Binding IsChecked, ElementName=AutomaticThemeToggle, Converter={StaticResource FilterNotConverter}}">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox" BasedOn="{StaticResource ThemeOptionList}">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBoxItem>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="40" Height="30" CornerRadius="5" Margin="0,0,10,0"
                                                    Background="#FF0D1114" BorderBrush="#FF24383A" BorderThickness="1">
                                                <Grid>
                                                    <Border Height="7" VerticalAlignment="Top" Background="#FF080B0D" BorderBrush="#FF3CCFC0" BorderThickness="0,0,0,2" CornerRadius="4,4,0,0" />
                                                    <Border Height="12" Margin="5,11,5,0" VerticalAlignment="Top" CornerRadius="3" Background="#FF131A1D" BorderBrush="#FF24383A" BorderThickness="1" />
                                                    <Border Width="13" Height="4" Margin="9,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="2" Background="#FF3CCFC0" />
                                                </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="卫戍协议终端" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="深灰机壳 · 青绿描边" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="40" Height="30" CornerRadius="2" Margin="0,0,10,0"
                                                    Background="#FFD8CFBE" BorderBrush="#FFB5A88F" BorderThickness="1">
                                                <Grid>
                                                    <Border Height="7" VerticalAlignment="Top" Background="#FF1C1B19" BorderBrush="#FFC8372A" BorderThickness="0,0,0,2" />
                                                    <Border Height="12" Margin="5,11,5,0" VerticalAlignment="Top" CornerRadius="1" Background="#FFF2EDE3" BorderBrush="#FFB5A88F" BorderThickness="1" />
                                                    <Border Width="13" Height="4" Margin="9,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FF24211D" />
                                                </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="乌萨斯齐心团" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="铁框 · 纸卡 · 海报红" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="40" Height="30" CornerRadius="5" Margin="0,0,10,0"
                                                    Background="#FFF5F3FA" BorderBrush="#FFD8D1EA" BorderThickness="1">
                                                <Grid>
                                                    <Border Height="7" VerticalAlignment="Top" Background="#FF251E3E" BorderBrush="#FFE58AB8" BorderThickness="0,0,0,2" CornerRadius="4,4,0,0" />
                                                    <Border Height="12" Margin="5,11,5,0" VerticalAlignment="Top" CornerRadius="3" Background="#FFFFFFFF" BorderBrush="#FFD8D1EA" BorderThickness="1" />
                                                    <Border Width="13" Height="4" Margin="9,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="2" Background="#FF6A52D9" />
                                                </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="“全能的”可露希尔" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="薰衣草白 · 紫色 · 像素数字" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </ListBoxItem>
                                </ListBox>
                                <TextBlock Text="选择游戏里的主题，或开启自动识别；未识别时保留当前主题。" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,6"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>

                                <TextBlock Text="游戏连接" Style="{StaticResource SettingsCaption}" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <DockPanel>
                                        <Border x:Name="GameConnectionIcon" Width="30" Height="30" CornerRadius="{DynamicResource RowCornerRadius}"
                                                Background="{DynamicResource SectionBackgroundBrush}" VerticalAlignment="Center" Margin="0,0,9,0">
                                            <TextBlock x:Name="GameConnectionGlyph" Text="PC" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <Button x:Name="GameConnectionButton" DockPanel.Dock="Right" Content="更改…" Click="OnGameConnection"
                                                Style="{StaticResource SmallActionButton}" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="GameConnectionTitle" Text="截图来源 · PC 客户端" FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock x:Name="GameConnectionStatus" Text="PC 窗口截图" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="游戏开始" Style="{StaticResource SettingsCaption}" />
                                <Border x:Name="GameStartCard" Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <Grid MinHeight="58">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="有阵容可用时" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="我的阵容" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <ComboBox x:Name="GameStartWithLineups" Grid.Column="1" FontSize="11" VerticalAlignment="Center" SelectionChanged="OnGameStartPageChanged" AutomationProperties.Name="有阵容可用时跳转到">
                                                <ComboBoxItem Content="本局可用" /><ComboBoxItem Content="待确认" />
                                            </ComboBox>
                                            <ToggleButton x:Name="GameStartFixLineups" Grid.Column="2" Height="30" Margin="6,0,0,0" Padding="5,3" VerticalAlignment="Center" Style="{StaticResource VariantToggleButton}" Background="{DynamicResource NeutralTintBrush}"
