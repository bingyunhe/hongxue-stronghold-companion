<Window x:Class="ASPAssistant.App.Windows.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="反馈与诊断" Width="480" Height="650" MinWidth="300" MinHeight="320"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False" Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" Icon="{StaticResource AspaLogo}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource DialogTitleBar}" MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Tag="{StaticResource IconClose}" ToolTip="关闭"
                            AutomationProperties.Name="关闭反馈窗口" Click="OnClose" Style="{StaticResource DialogCloseButton}" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource DialogTitleText}" Text="反馈与诊断" />
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="反馈包仅保存到本机，请检查内容后自行提交。" TextWrapping="Wrap"
                               FontSize="11" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <WrapPanel HorizontalAlignment="Right">
                        <Button x:Name="IssueButton" Content="打开反馈页面" Click="OnOpenIssue" Style="{StaticResource DialogSecondaryButton}" Margin="0,0,8,4" />
                        <Button x:Name="ExportButton" Content="导出反馈包" Click="OnExport" Style="{StaticResource DialogPrimaryButton}" Margin="0,0,0,4" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TabControl x:Name="FeedbackTabs" Margin="12" Style="{StaticResource DarkTabControl}" SelectionChanged="OnTabChanged">
                <TabItem Header="填写问题">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="4,10,4,4">
                            <TextBlock Text="问题类型" Margin="0,0,0,5" />
                            <ComboBox x:Name="CategoryBox" SelectedIndex="0" AutomationProperties.Name="问题类型">
                                <ComboBoxItem Content="程序报错" />
                                <ComboBoxItem Content="识别有误" />
                                <ComboBoxItem Content="功能建议" />
                            </ComboBox>
                            <TextBlock Text="问题描述（必填）" Margin="0,12,0,5" />
                            <TextBox x:Name="DescriptionBox" Style="{StaticResource DialogTextBox}" Height="86" AcceptsReturn="True"
                                     MaxLength="6000" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="OnDescriptionChanged" AutomationProperties.Name="问题描述" />
                            <TextBlock Text="复现步骤与预期结果" Margin="0,12,0,5" />
                            <TextBox x:Name="StepsBox" Style="{StaticResource DialogTextBox}" Height="70" AcceptsReturn="True"
                                     MaxLength="6000" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="复现步骤与预期结果" />
                            <StackPanel x:Name="BatchPanel" Visibility="Collapsed" Margin="0,8,0,2">
                                <Expander x:Name="GamePicker" Expanded="OnBatchSelection" Collapsed="OnBatchSelection">
                                    <Expander.Header><TextBlock Text="选择对局" Foreground="{DynamicResource TextPrimaryBrush}"/></Expander.Header>
                                    <StackPanel>
                                        <Button Content="全选" HorizontalAlignment="Left" Click="OnSelectAllGames" Style="{StaticResource SmallActionButton}"/>
                                        <StackPanel x:Name="GameChecks" />
                                    </StackPanel>
                                </Expander>
                                <TextBlock x:Name="BatchSummary" TextWrapping="Wrap" Margin="0,4"/>
                            </StackPanel>
                            <ComboBox x:Name="EventChoice" DisplayMemberPath="Label" Visibility="Collapsed" Margin="0,10,0,0"
                                      AutomationProperties.Name="按回合和时间选择识别记录" SelectionChanged="OnEventChanged" />
                            <TextBlock x:Name="RecognitionText" TextWrapping="Wrap" Margin="0,12,0,8" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel x:Name="MarkPanel" Visibility="Collapsed">
                                <ComboBox x:Name="MarkChoice" DisplayMemberPath="Label" SelectionChanged="OnMarkChanged" AutomationProperties.Name="选择棋盘标记" />
                                <TextBlock Text="实际姓名、空格或预期站位（选填）" Margin="0,6,0,2"/>
                                <TextBox x:Name="ExpectedBox" MaxLength="300" Style="{StaticResource DialogTextBox}" Margin="0,0,0,6" TextChanged="OnExpectedChanged"/>
                            </StackPanel>
                            <CheckBox x:Name="ScreenshotChoice" Content="附上这次识别画面" Checked="OnScreenshotChanged" Unchecked="OnScreenshotChanged"
                                      Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="PrivacyText" Text="截图可能含游戏昵称或聊天内容，请先查看下方画面。反馈包不包含个人阵容和设置文件。"
                                       TextWrapping="Wrap" Margin="0,6,0,8" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox x:Name="FrameChoice" DisplayMemberPath="Label" Visibility="Collapsed" Margin="0,0,0,6"
                                      AutomationProperties.Name="预览将附上的画面" SelectionChanged="OnFrameChanged" />
                            <Image x:Name="ScreenshotPreview" MaxHeight="170" Stretch="Uniform" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="预览内容">
                    <TextBox x:Name="PreviewBox" Style="{StaticResource DialogTextBox}" Margin="4,10,4,4"
                             IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="反馈内容预览" />
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
